#!/bin/bash
set -e

cd "$(dirname "$0")"

rm -f bootdisk.dsk bootdisk.o

# 1. Assemble
ca65 bootdisk.asm -o bootdisk.o

# 2. Link to full-sized ORICDISK image
ld65 -C bootdisk.cfg bootdisk.o -o bootdisk.dsk

# 3. Cleanup
rm -f bootdisk.o

echo "=== ORICDISK image ==="
ls -l bootdisk.dsk
echo
echo "Header check:"
hexdump -C -n 32 bootdisk.dsk
echo
echo "Boot sector (first 64 bytes of T0S1):"
hexdump -C -s 256 -n 64 bootdisk.dsk
echo
echo "SYSMAP signature (T0S4):"
hexdump -C -s $((256 + 3*512)) -n 32 bootdisk.dsk

# Optional: convert to MFM if old2mfm is present
if [ -x ./old2mfm ]; then
    echo
    echo "=== Converting to MFM_DISK ==="
    ./old2mfm bootdisk.dsk
    ls -l bootdisk.dsk
fi

echo
echo "Done. Copy bootdisk.dsk to your emulator / Gotek folder."
