#!/bin/bash
# 1. Compile the assembly file into a standard object block
ca65 bootdisk.asm -o bootdisk.o

# 2. Link the core boot codes to a temporary scratchpad file
ld65 -C bootdisk.cfg bootdisk.o -o boot_raw.bin

# 3. Create a perfectly sized blank track padding block (1,392,128 bytes)
# filled with the correct standard blank formatting data ($E5)
dd if=/dev/zero bs=1 count=1392128 2>/dev/null | tr '\000' '\345' > pad_raw.bin

# 4. Combine the boot signature header, code, and valid formatting bytes together
cat boot_raw.bin pad_raw.bin > bootdisk.dsk

# 5. Clean up temporary files
rm boot_raw.bin pad_raw.bin bootdisk.o

# 6. Verify total file footprint
ls -l bootdisk.dsk

cp bootdisk.dsk ~/ORIC/
