name=$1
case "${name##*/}" in ?*.*) name="${name%.*}";; esac  # PROG, PROG.c, PROG.ivm all ok
shift
echo "ARGS: $*"

. ./deps   # stale: rebuild only when a source changed

# recreate .lst asm and merge C force comments (also ivm-lib.o)
if stale ivm-jit.sim $IVM_SRC ivm-lib.asm cafix cafix.py ivm-jit; then
  ./cafix || exit 1
fi

sim65 -c ivm-jit.sim -z -j $* $name.ivm | grep cycles | sed 's/ cycles//' > $name.cycles.jit
sim65 -c ivm-jit.sim -z $* $name.ivm | tee $name.log

jit=$(cat "$name.cycles.jit")
jitandrun=$(grep cycles "$name.log" | sed 's/ cycles//')
run=$((jitandrun - jit))

rm -f $name.ivm.sim

echo 
echo 
echo "--- -t generate file ---"
if stale ivm-jit-map.sim $IVM_SRC ivm-lib.o ivm-jit; then
  cl65 -DMEMMAP -DJIT -Oirs -C sim6502.cfg -t sim6502 ivm-lib.o ivm.c -o ivm-jit-map.sim || exit 1
fi
sim65 -c ivm-jit-map.sim -j -z -tsim6502 $* $name.ivm -o$name.ivm.sim
echo
echo

sim65 -c $name.ivm.sim | tee $name.sim.log
simrun=$(grep cycles "$name.sim.log" | sed 's/ cycles//')

echo
echo
echo "============================================"
echo
echo "JIT      : $jit"
echo "JIT&RUN  : $jitandrun"
echo "RUN      : $run"
echo "SIM      : $simrun"
echo


echo
echo
ls -ugGlf ivm-jit.sim ivm-jit-map.sim $name.ivm $name.ivm.sim 2>/dev/null
echo
echo "=== ivm.c: `./wcode ivm.c` LOC ==="
echo "=== jit c: `./wcode ivm-jit.c` LOC ==="
echo

