name=$1
name="${name%.ivm}"
shift
echo "ARGS: $*"

rm ivm-jit.x ivm-vm.lst ivm-jit.sim ivm-jit.lst 2>/dev/null

# recreate .lst asm and merge C force comments
./cafix

sim65 -c ivm-jit.sim -z -j $* $name.ivm | grep cycles | sed 's/ cycles//' > $name.cycles.jit
sim65 -c ivm-jit.sim -z $* $name.ivm | tee $name.log

jit=$(cat "$name.cycles.jit")
jitandrun=$(grep cycles "$name.log" | sed 's/ cycles//')
run=$((jitandrun - jit))

echo
echo
echo "============================================"
echo
echo "JIT      : $jit"
echo "JIT&RUN  : $jitandrun"
echo "RUN      : $run"
echo

echo
echo
ls -ugGlf ivm-jit.sim ivm.x ivm-jit.x $name.ivm 2>/dev/null
echo
echo "=== ivm.c: `./wcode ivm.c` LOC ==="
echo "=== jit c: `./wcode ivm-jit.c` LOC ==="
echo

