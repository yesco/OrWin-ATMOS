name=orwin

# This has been adopted to build the "orwin.tap"
# and include and register:
# - app-PROG.c functions names PROG_app()
# - *.c        funcitons named PROG_bin()

# generate list of programs

# - app_PRG

rm -f apps_*.ext apps_*.reg

ls -1 app_*.c | sed 's/.c$//' | sed 's/^app_//' | xargs -I{} sh -c 'echo "extern int app_{}();" > apps_{}.ext'
ls -1 app_*.c | sed 's/.c$//' | sed 's/^app_//' | xargs -I{} sh -c 'echo "{\"{}\", app_{}},"    > apps_{}.reg'

#ls -l apps_*.*

# - PRG_main (stackers)

rm -f apps-*.ext apps-*.reg
ls -1 app-*.c | sed 's/.c$//' | sed 's/app-//' | xargs -I{} sh -c 'echo "extern int {}_main();" > apps-{}.ext'
ls -1 app-*.c | sed 's/.c$//' | sed 's/app-//' | xargs -I{} sh -c 'echo "{\"_{}\", {}_main},"   > apps-{}.reg'

#ls -l apps_*.*

echo

cat apps_*.ext apps-*.ext | sort > apps.ext
cat apps_*.reg apps-*.reg | sort > apps.reg

#(echo; echo; grep -in . apps.*; echo; echo)


