#!/usr/bin/env python3
# ptest - compile a test-NAME.c with ./pc, run it on every backend, compare
# the output to test-NAME.out (if any), report cycles and sizes.
#
#   ./ptest              all test-*.c, test-*-asm.asm, raxiss's samples
#   ./ptest empty        test-empty.c        (test-empty.c, test-empty ok too)
#   ./ptest 'dispatch*'  test-dispatch*.c    (quote it, or the shell globs)
#   ./ptest byte-sieve-prime   no test-byte-sieve-prime.c: byte-sieve-prime.c
#   ./ptest 06-sieve     raxiss's sample 06-sieve ('1?-*': a glob of them)
#
# What it prints:
#
#   ./ptest        only the = lines: the results (and the summary table)
#   ./ptest -v     also one progress line on stderr: [5/17] test: variant
#   ./ptest -v -v  everything: each command and its output
#
# On more than one test, after the summary table of cycles and bytes:
# a narrower table of each backend's cycles, as a multiple of one
# chosen backend's (default cc65 - oscar64 superoptimizes, a lopsided
# 1.000x party).  ./ptest -rel=oscar  picks oscar64 as that party
# instead.  Then a plain (not relative) table of bytes.
#
# The = lines also go to ptest.out (./ptest SPEC: ptest-SPEC.out): small,
# checked in, to follow the results over time.
#
# Everything else goes to TMP/ (a symlink to the system's tmp, one per
# clone; asked for the first time): each test runs on a copy there, so
# its .ivm .sim .log .got .expect land there, and the whole run's log:
# TMP/ptest.log (TMP/ptest-SPEC.log).
#
# Per test, logs: test-NAME.{pc,ivm,asm,fix,jit,hjit,cc65-build,cc65,oscar}.log
#   outputs:      test-NAME.expect (.out or majority), test-NAME.VARIANT.got
#
# Variants:
#   ivm    ./ivm       cc65 C VM            size: .ivm
#   asm    ./ivm-asm   asm VM               size: .ivm
#   fix    ./ivm-fix   asm VM, fixed mem[]  size: .ivm
#   zpjit  the host compiler's image (ivm-jit.x -z -o .jit.sim), sim65:
#          mem[] in zero page               size: .jit.sim
#   ztap   Atmos TAP from the same JIT      size: .tap
#   hjit   ivm-jit.x   the same JIT on the host cpu sim (cpu6502.c):
#          mem[] at $0300, not zp; lib calls 0 cycles  size: emitted code
#   cc65   cl65 -Dputz=puts -Iptest-include -Cl -Os [putn.c]  size: .sim
#   oscar  oscar64 -Iptest-include -Os -ep [putn.c] ...       size: .prg
#
# A test-NAME-asm.asm (6502 asm, ivm-lib's routines on their own, no
# compiler) has one variant:
#   lib    cl65 -t sim6502 NAME.asm ivm-lib.asm, sim65  size: .sim
#
# raxiss's samples (RAX, ../oricCompilerBenchmark): each runs as
# test-rax-NN-name, with two changes:
# - its #include "..." are inlined
# - <conio.h> <types.h> are "conio.h" "types.h": their libmos6502vm's,
#   copied to TMP (the compiler skips them: c.bnf has its own _putc
#   _puts peek poke MEMPTR uint8_t ...)
# cc65 and oscar also get their _puts.c and a _putc that is putchar
# (TMP/rax-io.c). The .out is what their own gcc command prints
# (tools/test-samples.sh).

import collections, difflib, glob, os, pty, re, shlex, shutil, signal
import subprocess, sys, threading

inc = os.path.abspath("ptest-include")
# then
# cl65 -I{inc} ...

TIMEOUT = 30    # a hang, not a slow test: test-dispatch-loop on ivm (cc65
                # C VM under sim65, 6.9B cycles) genuinely takes ~48s
OSCAR64 = os.environ.get("OSCAR64",
                         os.path.expanduser("~/GIT/oscar64/bin/oscar64"))
RAX = "../oricCompilerBenchmark/playground"
TMP = "TMP"

out = None       # the whole run's log (TMP)
res_out = None   # the = lines (ptest.out)
verbose = 0      # -v: progress, -v -v: everything
step_n = (0, 0)  # [k/n] for the progress line


def say(s=""):
    """a line for the log; the terminal: at -v -v, or a = line"""
    out.write(s + "\n")
    out.flush()
    if s.startswith("="):
        res_out.write(s + "\n")
        res_out.flush()
    if verbose >= 2 or s.startswith("="):
        if verbose == 1:
            sys.stderr.write("\r\x1b[K")         # (the progress line)
        sys.stdout.write(s + "\n")
        sys.stdout.flush()


def step(t, what):
    """-v: one progress line on stderr, overwritten each time"""
    if verbose == 1:
        k, n = step_n
        sys.stderr.write("\r[%d/%d] %s: %s\x1b[K" % (k, n, base(t), what))
        sys.stderr.flush()


def base(t):
    return os.path.basename(t)


def run(cmd, log):
    """Run cmd (list), stream its output as '  | ' lines (never ^=), save
    stdout+stderr to log, return the text. A pty keeps the tools (sim65,
    printf) line buffered, so the output moves while it runs."""
    if verbose >= 2:
        sys.stderr.write("\n$ %s    > %s\n" % (" ".join(cmd), log))
        sys.stderr.flush()
    out.write("\n$ %s    > %s\n" % (" ".join(cmd), log))
    master, slave = pty.openpty()
    # its own process group: the timeout kills it all (bash ./ivm-asm: its
    # sim65 too, it would keep the pty open)
    p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=slave,
                         stderr=slave, close_fds=True, start_new_session=True)
    os.close(slave)
    timer = threading.Timer(TIMEOUT, lambda: os.killpg(p.pid, signal.SIGKILL))
    timer.start()
    buf, lines = b"", []
    with open(log, "w") as f:
        f.write("$ " + " ".join(cmd) + "\n")

        def line(l):
            l = l.decode("latin-1").rstrip("\r")
            lines.append(l)
            f.write(l + "\n")
            say("  | " + l)

        while True:
            try:
                d = os.read(master, 4096)
            except OSError:  # EIO: child side closed
                d = b""
            if not d: break
            buf += d
            while b"\n" in buf:
                l, buf = buf.split(b"\n", 1)
                line(l)
        if buf: line(buf)
        os.close(master)
        p.wait()
        if not timer.is_alive():
            line(b"%%Error: TIMEOUT after %d s" % TIMEOUT)
        timer.cancel()
    return unglue("\n".join(lines) + "\n")


def unglue(text):
    """output without a newline at its end: the runner's lines after it
    on their own line again (sim65's "N cycles", ivm's --- END ---, the
    host sim's --- SIM:, oscar's Emulation result / Total Cycles)"""
    text = re.sub(r"(?<=[^\n])(--- END ---|--- SIM: |Emulation result|"
                  r"Total Cycles)", r"\n\1", text)
    lines = text.rstrip("\n").split("\n")
    m = re.match(r"^(.*\D)(\d+ cycles)$", lines[-1])
    if m:                                      # "... 4093 12568166 cycles"
        lines[-1:] = [m.group(1), m.group(2)]
    return "\n".join(lines) + "\n"


def between(text, start, end):
    """Lines after the first line matching start, before one matching end."""
    lines, on = [], False
    for l in text.splitlines():
        if on and re.match(end, l): return lines
        if on: lines.append(l)
        elif re.match(start, l): on = True
    return lines if on else None


def norm(lines):
    if lines is None: return None
    # whitespace runs count as one space: oscar64 prints tabs as spaces
    lines = [" ".join(l.split()) for l in lines]
    while lines and not lines[0]: lines.pop(0)
    while lines and not lines[-1]: lines.pop()
    return lines


def last_int(pat, text):
    m = re.findall(pat, text, re.M)
    return int(m[-1]) if m else None


def fsize(f):
    return os.path.getsize(f) if os.path.exists(f) else None


def ratio(v, bv):
    """v as a multiple of bv, as short as stays readable: 1.000x, 5.70x,
    426x (so a huge cycle count doesn't blow up the column)."""
    r = v / bv
    if abs(r) >= 100: return "%.0fx" % r
    if abs(r) >= 10: return "%.1fx" % r
    return "%.3fx" % r


def rm(*fs):
    for f in fs:
        if os.path.exists(f): os.remove(f)


def ivm_out(text):
    return between(text, r"--- RUN IVM", r"--- END ---")


def sim_out(text):
    # sim65 run: all lines but the trailing "N cycles"
    return [l for l in text.splitlines()
            if not re.match(r"^\d+ cycles$", l)]


def needs_putn(t):
    """True if the test's .c contains the string 'putn'."""
    try:
        with open(t + ".c", encoding="latin-1") as f:
            return "putn" in f.read()
    except OSError:
        return False


def repro(name, t):
    """The command that reruns variant name of test t by hand."""
    putn = " putn.c" if needs_putn(t) else " -Dputz=puts"
    
    return {
        "pc":    "./pc {t}",
        "ivm":   "./ivm {t}",
        "asm":   "./ivm-asm {t}",
        "fix":   "./ivm-fix {t}",
        "zpjit": "./ivm-jit.x -z -tsim6502 -o{t}.jit.sim {t}.ivm && sim65 -c {t}.jit.sim",
        "ztap":  "./ivm-jit.x -z -tatmos -o{t}.tap {t}.ivm",
        "hjit":  "./ivm-jit.x {t}.ivm",
        "cc65":  "cl65 -Dxputz=puts -Iptest-include -t sim6502 -Cl -Os -o {t}.sim {t}.c" + putn + " && sim65 -c {t}.sim",
        "oscar": "./oscar -O3 -Dxputz=puts -Os -ep" + putn + " {t}.c",
        "lib":   "cl65 -t sim6502 -o {t}.sim {t}.asm ivm-lib.asm && sim65 -c {t}.sim",
    }[name].format(t=t)


# ---- TMP --------------------------------------------------------------------

def tmp_dir():
    """TMP: a symlink to the system's tmp, its own dir per clone (the repo
    dir's name). The first time: asked (a terminal), else just made"""
    if os.path.isdir(TMP):
        return
    to = os.path.join(os.environ.get("TMPDIR", "/tmp"),
                      os.path.basename(os.getcwd()))
    # both ends of the chat need to be a terminal: stdin to read the
    # answer, stderr to show the question - else it's invisible and
    # readline() still blocks on it forever (redirect either one away:
    # just make it, no asking)
    if sys.stdin.isatty() and sys.stderr.isatty():
        sys.stderr.write("ptest: create %s -> %s? [Y/n] " % (TMP, to))
        sys.stderr.flush()
        if sys.stdin.readline().strip().lower() in ("n", "no"):
            sys.exit("%Error: ptest: no TMP")
    os.makedirs(to, exist_ok=True)
    if os.path.lexists(TMP):
        os.remove(TMP)                       # a dangling link
    os.symlink(to, TMP)


def to_tmp(src):
    """a test (its .c / .asm, its .out) copied to TMP: its name there.
    #pragma TIMED lines are stripped so oscar64 does not choke on them."""
    name, ext = src.rsplit(".", 1)
    t = os.path.join(TMP, base(name))
    dest = t + "." + ext
    if ext == "c":
        with open(src, encoding="latin-1") as f:
            text = f.read()
        text = re.sub(r'^\s*#pragma\s+TIMED\b[^\n]*\n?', '', text, flags=re.M)
        with open(dest, "w", encoding="latin-1") as f:
            f.write(text)
    else:
        shutil.copyfile(src, dest)
    rm(t + ".out")
    if os.path.exists(name + ".out"):
        shutil.copyfile(name + ".out", t + ".out")
    return t


# ---- raxiss's samples ---------------------------------------------------------

def rax_samples(pat="[0-9][0-9]-*"):
    """the sample dirs matching pat (NN-name)"""
    d = os.path.join(RAX, "samples")
    return sorted(p for p in glob.glob(os.path.join(d, pat)) if os.path.isdir(p))


def rax_inline(path, seen):
    """a file's text, its #include "..." replaced by theirs (once each)"""
    lines = []
    for l in open(path, encoding="latin-1").read().split("\n"):
        m = re.match(r'^\s*#\s*include\s+"([^"]+)"', l)
        if m:
            inc = os.path.normpath(os.path.join(os.path.dirname(path), m.group(1)))
            if inc not in seen and os.path.exists(inc):
                seen.add(inc)
                lines += ["// ---- %s (inlined) ----" % m.group(1)]
                lines += rax_inline(inc, seen)
                lines += ["// ---- end of %s ----" % m.group(1)]
                continue
        lines.append(l)
    return lines


RAX_IO = ["_puts.c", "rax-io.c"]              # cc65, oscar: the I/O


def rax_io():
    """their conio.h types.h _puts.c in TMP, and rax-io.c: _putc"""
    lib = os.path.join(RAX, "libmos6502vm")
    for f in ("conio.h", "types.h", "_puts.c"):
        shutil.copyfile(os.path.join(lib, f), os.path.join(TMP, f))
    open(os.path.join(TMP, "rax-io.c"), "w").write(
        "// their _putc (a store to the mos6502vm's port): putchar\n"
        "#include <stdio.h>\n#include \"conio.h\"\n"
        "void _putc(const char c) { putchar(c); }\n")


def rax_test(d):
    """sample dir d as TMP/test-rax-NN-name.c, its .out from their gcc"""
    name = os.path.basename(d)
    t = os.path.join(TMP, "test-rax-" + name)
    srcs = sorted(glob.glob(os.path.join(d, "*.c")))
    head = ["// test-rax-%s.c - raxiss's sample %s (made by ptest)" % (name, name),
            "//",
            "// From %s." % d,
            "// Changed: its #include \"...\" inlined, <conio.h> <types.h>",
            "// as \"conio.h\" \"types.h\" (theirs, in TMP).",
            ""]
    body = []
    for s in srcs:
        body += rax_inline(s, set())
    body = [re.sub(r'^(\s*#\s*include\s*)<(conio|types)\.h>', r'\1"\2.h"', l)
            for l in body]
    rax_io()
    open(t + ".c", "w").write("\n".join(head + body) + "\n")

    # the reference: their gcc command (tools/test-samples.sh) on the original
    lib = os.path.join(RAX, "libmos6502vm")
    exe = t + ".host"
    rm(t + ".out", exe)
    cmd = ["gcc", "-w", "-o", exe] + srcs + [os.path.join(lib, "_puts.c"),
           "-I", os.path.join(RAX, "samples"), "-I", lib,
           "-D__HOST_C__", "-D_putc=putchar",
           "-Wno-error=implicit-function-declaration"]   # (clang: putchar)
    if subprocess.run(cmd, stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode == 0:
        try:
            r = subprocess.run([exe], stdout=subprocess.PIPE, timeout=60)
            open(t + ".out", "wb").write(r.stdout)
        except subprocess.TimeoutExpired:
            pass
    return t


# ---- a test -------------------------------------------------------------------

def test(t):
    """Run all variants of test t (TMP/test-empty). Returns result list."""
    res = []  # (name, cycles, bytes, file, output-lines, log)

    say("#" * 60)
    say("=== ./ptest %s" % re.sub(r"^test-", "", base(t)))
    say("#" * 60)

    # test-NAME-asm.asm: the lib's routines in asm, no compiler
    if t.endswith("-asm") and os.path.exists(t + ".asm"):
        return test_lib(t)

    step(t, "pc")
    rm(t + ".ivm")
    run(["bash", "./pc", t], t + ".pc.log")
    have_ivm = os.path.exists(t + ".ivm")
    if not have_ivm:
        say("%%Error: ./pc %s: no %s.ivm (see %s.pc.log)" % (t, t, t))

    if have_ivm:
        step(t, "ivm")
        s = run(["bash", "./ivm", t], t + ".ivm.log")
        res.append(("ivm", last_int(r"^(\d+) cycles$", s),
                    fsize(t + ".ivm"), t + ".ivm", ivm_out(s), t + ".ivm.log"))

        step(t, "asm")
        s = run(["bash", "./ivm-asm", t], t + ".asm.log")
        res.append(("asm", last_int(r"^(\d+) cycles$", s),
                    fsize(t + ".ivm"), t + ".ivm", ivm_out(s), t + ".asm.log"))

        step(t, "fix")
        s = run(["bash", "./ivm-fix", t], t + ".fix.log")
        res.append(("fix", last_int(r"^(\d+) cycles$", s),
                    fsize(t + ".ivm"), t + ".ivm", ivm_out(s), t + ".fix.log"))

        # jit: the host compiler writes the image, sim65 runs it
        step(t, "zpjit")
        rm(t + ".jit.sim")
        run(["./ivm-jit.x", "-z", "-tsim6502", "-o" + t + ".jit.sim",
             t + ".ivm"], t + ".jit-build.log")
        s, o = "", None
        if os.path.exists(t + ".jit.sim"):
            s = run(["sim65", "-c", t + ".jit.sim"], t + ".jit.log")
            o = sim_out(s)
        res.append(("zpjit", last_int(r"^(\d+) cycles$", s),
                    fsize(t + ".jit.sim"), t + ".jit.sim", o, t + ".jit.log"))

        # ztap: Atmos TAP generated by the same JIT
        step(t, "ztap")
        rm(t + ".tap")
        run(["./ivm-jit.x", "-z", "-tatmos", "-o" + t + ".tap", t + ".ivm"],
            t + ".ztap.log")
        tapsize = fsize(t + ".tap")
        # cycles=0 so results() does not treat it as FAILED; size is what matters
        res.append(("ztap", 0 if tapsize else None, tapsize, t + ".tap",
                    [] if tapsize else None, t + ".ztap.log"))

        # hjit: the same JIT run in cpu6502.c on the host
        step(t, "hjit")
        s = run(["./ivm-jit.x", t + ".ivm"], t + ".hjit.log")
        m = re.search(r"code \$\w+-\$\w+ \((\d+) B\)", s)
        res.append(("hjit", last_int(r"^--- SIM: (\d+) cycles", s),
                    int(m.group(1)) if m else None, "code",
                    between(s, r"--- SIM: mem\[\]", r"--- SIM: \d+ cycles"),
                    t + ".hjit.log"))

    # a raxiss sample: its I/O too (rax_io)
    io = ([os.path.join(TMP, f) for f in RAX_IO]
          if base(t).startswith("test-rax-") else [])

    # only pull putn.c if the test actually uses it
    putn = ["putn.c"] if needs_putn(t) else ["-Dputz=puts"]

    step(t, "cc65")
    rm(t + ".sim")
    s = run(["cl65", f"-I{inc}", "-Dxputz=puts", "-t", "sim6502", "-Cl", "-Os",
             "-o", t + ".sim", t + ".c"] + putn + io,
            t + ".cc65-build.log")
    if os.path.exists(t + ".sim"):
        s = run(["sim65", "-c", t + ".sim"], t + ".cc65.log")
        res.append(("cc65", last_int(r"^(\d+) cycles$", s),
                    fsize(t + ".sim"), t + ".sim", sim_out(s),
                    t + ".cc65.log"))
    else:
        res.append(("cc65", None, None, t + ".sim", None,
                    t + ".cc65-build.log"))

    step(t, "oscar")
    rm(t + ".prg")
    s = run([OSCAR64, "-DOSCAR64", f"-i={inc}"] + putn + ["-Dxputz=puts", "-Os", "-ep"] +
            [t + ".c", "-o=" + t + ".prg"] + io, t + ".oscar.log")
    if os.path.exists(t + ".asm"):              # its listing (not ours)
        os.replace(t + ".asm", t + ".oscar.s")
    res.append(("oscar", last_int(r"^Total Cycles (\d+)", s),
                fsize(t + ".prg"), t + ".prg",
                between(s, r"Running emulation", r"Emulation result"),
                t + ".oscar.log"))

    return results(t, res, have_ivm)


def test_lib(t):
    """a test-NAME-asm.asm: built with ivm-lib.asm, run on sim65"""
    res = []
    step(t, "lib")
    rm(t + ".sim")
    had_o = os.path.exists("ivm-lib.o")
    run(["cl65", "-t", "sim6502", "-o", t + ".sim", t + ".asm", "ivm-lib.asm"],
        t + ".lib-build.log")
    rm(t + ".o")
    if not had_o: rm("ivm-lib.o")               # (cl65's, here)
    s, o = "", None
    if os.path.exists(t + ".sim"):
        s = run(["sim65", "-c", t + ".sim"], t + ".lib.log")
        o = sim_out(s)
    res.append(("lib", last_int(r"^(\d+) cycles$", s), fsize(t + ".sim"),
                t + ".sim", o, t + ".lib.log"))
    return results(t, res, True)


def results(t, res, have_ivm):
    """compare each variant's output, print the results"""
    n = base(t)
    # expected output: .out (its RUN IVM .. END part if it has one), else
    # the majority. Saved as t.expect, each variant's as t.NAME.got: diff them
    ref, refname = None, None
    if os.path.exists(t + ".out"):
        e = open(t + ".out", encoding="latin-1").read()
        ref = norm(ivm_out(e) or e.splitlines())
        refname = n + ".out"
    else:  # no .out: what most backends print (ties: the first, ivm)
        outs = [tuple(norm(r[4])) for r in res if r[4] is not None]
        if outs:
            ref = list(collections.Counter(outs).most_common(1)[0][0])
            refname = "majority"
    if ref is not None:
        with open(t + ".expect", "w") as f:
            f.write("".join(l + "\n" for l in ref))

    # per variant: None ok, "FAILED", or "DIFFERS k/n"
    status = {}
    for name, cyc, size, f, o, log in res:
        say()
        say("-- %s --" % name.upper())
        o = norm(o)
        if cyc is None or o is None:
            status[name] = "FAILED"
            say("%%Error: %s FAILED on %s (see %s )" % (name, n, log))
            say("  rerun: " + repro(name, t))
            continue
        say("%8s bytes %s" % (size if size is not None else "?", f))
        say("%8d cycles" % cyc)
        got = "%s.%s.got" % (t, name)
        with open(got, "w") as gf:
            gf.write("".join(l + "\n" for l in o))
        if ref is None:
            say("(no %s.out)" % n)
        elif o == ref:
            say("matches" if refname != "majority" else "same as majority")
        else:
            ops = difflib.SequenceMatcher(None, ref, o).get_opcodes()
            k = sum(max(i2 - i1, j2 - j1) for op, i1, i2, j1, j2 in ops
                    if op != "equal")
            status[name] = "DIFFERS %d/%d" % (k, max(len(ref), len(o)))
            say("%%Error: %s %s lines from %s on %s" %
                (name, status[name], refname, n))
            say("  rerun: " + repro(name, t))
            say("diff %s.expect %s" % (t, got))
            d = list(difflib.unified_diff(ref, o, t + ".expect", got, n=1,
                                          lineterm=""))
            for l in d[:24]: say("  " + l)
            if len(d) > 24: say("  ...")

    say()
    say("# results")
    w = max([len("{:,}".format(c or 0)) for _, c, *_ in res] + [1])
    if not have_ivm:
        say("= %s %-21s - %-5s - %s" % ("-".rjust(w), "FAILED", "pc", n))
        say("= %s %s" % (" " * w, repro("pc", t)))
    for name, cyc, size, f, o, log in res:
        st = status.get(name)
        if st == "FAILED":
            say("= %s %-21s - %-5s - %s" % ("-".rjust(w), "FAILED", name, n))
        else:
            # B/BC: native size / .ivm size, for non-interpreter backends
            bbc = ""
            if name not in ("ivm", "asm", "fix") and size and have_ivm:
                ivm_size = fsize(t + ".ivm")
                if ivm_size:
                    bbc = "  %.2f B/BC" % (size / ivm_size)
            say("= %s cycles (%5s bytes) - %-5s - %s%s%s" %
                ("{:,}".format(cyc).rjust(w) if cyc is not None else "-".rjust(w),
                 size if size is not None else "?",
                 name, n, "  " + st if st else "", bbc))
        if st:
            say("= %s %s" % (" " * w, repro(name, t)))
    say()
    return res, status


def rel_table(allres, names, baseline, idx, label):
    """print one extra table: every backend's cycles (idx 1), as a
    multiple of baseline's (the 1.000x party, default cc65 - oscar64
    superoptimizes and makes a lopsided baseline). FAIL/- as in the
    main table; a test whose baseline didn't run is all '-' (nothing
    to be a multiple of)."""
    rows = []
    for t, (res, status) in allres:
        row = {r[0]: r for r in res}
        br = row.get(baseline)
        bv = br[idx] if br and status.get(baseline) != "FAILED" else None
        cells = []
        for n in names:
            r, st = row.get(n), status.get(n)
            if st == "FAILED":
                cells.append("FAIL")
            elif r is None or r[idx] is None or not bv:
                cells.append("-")
            else:
                cells.append(ratio(r[idx], bv))
        rows.append((base(t), cells))
    tw = max([len(n) for n, _ in rows] + [len("test")])
    w = [max(len(n), max(len(c[i]) for _, c in rows)) for i, n in enumerate(names)]
    say("=")
    say("=")
    say("=== RELATIVE %s (%s = 1.000x)" % (label, baseline))
    say("= %-*s%s" % (tw, "test",
        "".join(" %*s" % (w[i], n) for i, n in enumerate(names))))
    for n, cells in rows:
        say("= %-*s%s" % (tw, n,
            "".join(" %*s" % (w[i], c) for i, c in enumerate(cells))))
    say()


def size_table(allres, names):
    """print every backend's file size in bytes, plain (not relative:
    bytes don't get smaller just because another party is dense),
    6-digit columns."""
    rows = []
    for t, (res, status) in allres:
        row = {r[0]: r for r in res}
        cells = []
        for n in names:
            r, st = row.get(n), status.get(n)
            if st == "FAILED":
                cells.append("FAIL")
            elif r is None or r[2] is None:
                cells.append("-")
            else:
                cells.append("{:,}".format(r[2]))
        rows.append((base(t), cells))
    tw = max([len(n) for n, _ in rows] + [len("test")])
    w = 6
    say("=")
    say("=== BYTES")
    say("= %-*s%s" % (tw, "test", "".join(" %*s" % (w, n) for n in names)))
    for n, cells in rows:
        say("= %-*s%s" % (tw, n, "".join(" %*s" % (w, c) for c in cells)))
    say()


# ---- main ---------------------------------------------------------------------

def main():
    global out, res_out, verbose, step_n
    args = sys.argv[1:]
    verbose = sum(a.count("v") for a in args if re.match(r"^-v+$", a))
    rel_m = [re.match(r"^-rel=(\w+)$", a) for a in args]
    rel_base = next((m.group(1) for m in rel_m if m), "cc65")
    specs = [a for a in args if not re.match(r"^-v+$", a)
             and not re.match(r"^-rel=\w+$", a)]
    tmp_dir()

    # the tests: ours (in the repo dir), raxiss's samples (dirs in RAX)
    srcs, raxs = [], []
    if not specs:
        srcs = sorted(glob.glob("test-*.c") + glob.glob("test-*-asm.asm"))
        raxs = rax_samples()
    for s in specs:
        s = re.sub(r"([^/])\.[^./]*$", r"\1", s)   # foo.c foo.ivm -> foo
        s = re.sub(r"^test-", "", s)
        if re.match(r"^([0-9]|\?\?-|\[)", s) and rax_samples(s):   # 06-sieve '1?-*'
            raxs += [d for d in rax_samples(s) if d not in raxs]
            continue
        # test-NAME.c, else the literal NAME.c (./ptest byte-sieve-prime)
        got = (sorted(glob.glob("test-%s.c" % s) + glob.glob("test-%s.asm" % s))
               or sorted(glob.glob(s + ".c")))
        if not got: print("%%Error: no test-%s.c or %s.c" % (s, s))
        srcs += [g for g in got if g not in srcs]

    spec = "-".join(re.sub(r"^test-|\.c$", "", s) for s in specs)
    spec = spec.replace("*", "ALL").replace("?", "_").replace("/", "_")
    if raxs and not srcs:                      # only raxiss's: ptest-rax
        spec = "rax" if spec == "__-ALL" else "rax-" + spec
    name = "ptest-%s" % spec if spec else "ptest"
    out = open(os.path.join(TMP, name + ".log"), "w")
    res_out = open(name + ".out", "w")

    # the host compiler and its lib (jit, hjit): when a source changed
    run(["bash", "-c", ". ./deps; "
         "if stale ivm-jit.x $IVM_SRC jit; then "
         "clang -DMEMMAP -DVERBOSE -DJIT -g ivm.c -o ivm-jit.x || exit 1; fi; "
         "if stale ivm-lib-sim6502.bin ivm-lib.asm mklib; then ./mklib; fi"],
        os.path.join(TMP, "ptest-build.log"))

    # copies in TMP: everything they make lands there
    tests = [to_tmp(s) for s in srcs] + [rax_test(d) for d in raxs]
    allres = []
    for k, t in enumerate(tests):
        step_n = (k + 1, len(tests))
        allres.append((t, test(t)))
    if verbose == 1:
        sys.stderr.write("\r\x1b[K")

    if len(tests) > 1:
        say("#" * 60)
        say("=== ./ptest %s   (%d tests)" %
            (" ".join(shlex.quote(a) for a in specs), len(tests)))
        say("#" * 60)
        names = ["ivm", "asm", "fix", "zpjit", "ztap", "hjit", "cc65", "oscar", "lib"]
        say("= %-28s" % "test" + "".join("%15s" % n for n in names))
        for t, (res, status) in allres:
            row = {r[0]: r for r in res}
            cells = []
            for n in names:
                r, st = row.get(n), status.get(n)
                cells.append("%15s" % ("- " if r is None else
                             "FAIL " if st == "FAILED" else
                             "{:,}".format(r[1]) + ("*" if st else " ")))
            say("= %-28s" % base(t) + "".join(cells))
        say("= (* output differs, FAIL: failed, -: not run; see each test's"
            " results above)")
        say()

        if rel_base not in names:
            print("%%Error: -rel=%s: not a backend (%s)" %
                  (rel_base, ", ".join(names)))
        else:
            rel_table(allres, names, rel_base, 1, "CYCLES")
            size_table(allres, names)

    out.close()
    res_out.close()


if __name__ == "__main__":
    main()
