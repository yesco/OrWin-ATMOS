# -- BNF for C → IVM engine
# Arguments Block Cscopedeclstatements Declare Expr Func
# Gswitch Hassign Intcharetc Jprintone Kstatements
# Massvardecl L(oop-for) Oexpr Program 
# Q#lines RstartvalueofE Simpleval
# Type Uvardecl Var WprintitemJ Z H
#
# Rules are called as $X: $A..$Z, $a..$z for minor helpers (same letter
# as the rule they help); plain letters in a pattern are literals
# -- letters free: N, all of $a..$z

# Features TODO/missing:
# - casting, advanced pointer stuff
# - * is char, and [] is int, p++ is for char
# - do ... while continue break
# - switch ... case
# - label: goto label;
# - actual include (ignored for now!)
# - const arrays (initilized)
# - operators: left to right, a tighter one after a looser one does not
#   parse (rule O): a + b * c needs parentheses
# - printf very limited; putchar putz puts putn putnl nl


# =============================================

# - comment spec
#= /* */
#= //

# - Program starts with P
P=$D

# - Top level: declarations, functions, # lines (Q), structs (d: after V,
#   a backtracked \f leaks its vector: no code, the JIT calls 0)
D=static \<|extern \<
|$Q\o\<
|$V\o\<|$d\o\<|$F\o\<|\!\o\<|

# - Structs: a prototype, declared like a function (\f \{ \p), its params
#   are the fields: field k is word k. \q ends it (instead of \}): no
#   code, the params stay, the name is a const (the field count).
#   A struct variable is a static array (\@ bss, = {..} \: data, consts
#   only), p.f and p->f are the same: ( p k  (\m: k, R and H rules)
d=struct \f\{ {$f}\q;
f=$T \p$e;\<|
e=,\p\<|

# - # lines, at the top and in blocks (C)
#   #define NAME number|"string" -> const (\c only after a full match: a
#   failed alt must not leave it set). Predefined (parse.c predef, made
#   when first used): __MC65__ the version (the .ivm mark's last 2 bytes,
#   hi lo), __TARGET_6502__ 1
#   #ifdef / #ifndef NAME, #if 0 / #if N: a false one skips lines (\%) to
#   its #else / #endif; an #else reached is the end of a true one: skips
#   to #endif. #endif, any other # line: skipped
Q=#define \+ \d\c[\g]\n
|#define \+ \s\c[\g]\n
|#ifdef \i\*\n
|#ifdef \*\n\%
|#ifndef \i\*\n\%
|#ifndef \*\n
|#if 0\n\%|#if 0 \*\n\%
|#if \d\*\n
|#else\*\n\%
|#\*\n

# - Declarations: optional register\b -> REGISTER slot 0..31
# -O: REGISTER 0..31, other globals 32..95, frames at 96+
V=const\c $T $M;|register\b $T $M;|static $T $M;
|struct\'w \i \+={\:$N}\.;|struct\'w \i \+\@;
|$T $M;
# name[N]: a static array of N (a number or const) elements: zeroed (\@),
#   also = {0}; initialized: = "text" / = {1, 2, 'c', ...} (\: \, \.),
#   [] its size from the initializer, [N] zeros after it. Arrays are
#   static: initialized once (locals too: C wants "static" there)
M=\+\[$S\]={0}\@$U
|\+\[$S\]=\:\s\.$U|\+\[\]=\:\s\.$U
|\+\[$S\]={\:$N}\.$U|\+\[\]={\:$N}\.$U
|\+\[$S\]\@$U|\+=$S[\g]$U|\+=$E[S\1]$U|\+$U|
# initializer elements: consts, a trailing , allowed. The , before \, : a
#   failed alt does not take back data (the last one went in twice)
N=$S,\,\<|$S\,|

# - TODO: deep recursion might be bad...
U=,$M|

# - TODO: why I^* - pascal artifact?
T=struct\'W \i *|$I *\'^|$I^*\'^|$I
I=int\'w|word\'w|void\'w|char\'c|unsigned int\'w|unsigned char\'c

# - Function/Args definition
F=\o$T \f\{($A)\r $B \}[X]\o
A=void|$T \p,$A|$T \p|

# - Block
# a statement that does not parse: reported, skipped (\!: to its ;, over
#   a { } block), the next one is tried: all the errors of a file in one
#   run, no .ivm. The same for declarations / functions (rule D)
B={ \{ $C } \}
C=$V\<|$K\<|$Q\<|\!\<|

# - Statements — keywords / specific forms first
# if (l OP r), l simple (S), r simple or an R (into a temp): t / u as
#   compare-and-branch (no 0/1, no G): u l r skip = "if (l < r) body",
#   t: <=, > and >= swap l r. Not closed by n / B, the JIT sees it is no
#   loop. Smaller than the generic form (that spills l). R OP ...: the
#   generic if (E) is smaller, the JIT fuses "< s ? G" into a branch
K=$Y
|if ($E)[?G\x] $K else[0?G\x\w\y] $K[\y]
|if ($E)[?G\x] $K[\y]

# - Switch
# \sXX - not implemented cannot enable
#|switch (E) [\s1 G\x] { \{ G \} [\y\s4] }\<
# TODO: make work: for & while continue; ?
#|break;[J\s3]\<

# - Loops

|for($L

# while (v <= lim): the VM 't' is the test itself, 'B' jumps back to it
|while (\i<=\d) [\mt\1\2\x] $K[B\z\y]
|while (\i<=\i) [\mt\1\2\x] $K[B\z\y]
|while (\i<\d) [\mu\1\2\x] $K[B\z\y]
|while (\i<\i) [\mu\1\2\x] $K[B\z\y]
# while (l OP r): the same t / u test at the top, B back to the mark
|$X
|while ([\m]$E) [?G\x] $K[B\z\y]


# - Input / Output
# TODO: put these as prefix starting with pX X many alts
|putchar('\\n');[N]
|putchar(\d);[O\c1]
|putchar(\i);[L\1E]
|putchar($E);[E]

|puts("["]\u);[N]
|puts(\i);[L\1PN]

|fflush(stdout);
|fputs("["]\u,stdout);
|fputs(\i,stdout);[L\1P]

# single string constant - common
|printf("["]\u);

|printf("%s",\i);[L\1P]

|printf("%u\ ",$E);[.O ]
|printf("%d\ ",$E);[.O ]

|printf("%u\\n",$E);[.N]
|printf("%d\\n",$E);[.N]

|printf("%d",$E);[.]
|printf("%u",$E);[.]

|printf(\i);[L\1P]

# - TODO: lol?
|printf("%u%u%u\\\\n",$E,$E,$E);[...N]
|printf("%u%u%u",$E,$E,$E);[...]
|printf("\\"%s\\" has %d characters\\n",\i,\i($Z)[\v]);[S\tL\1P" has \#00L\3.N]

|printf($E);[P]

|putz("["]\u);
|putz($E);[P]
|putnl($E);[.N]
|putn($E);[.O ]
|nl();[N]

# - TODO: vararg printf?
#|printf(JW);

# - a dummy catch all - WRONG!
|printf("["]\u, $E);[.]

# - other functions
|memset(\i,\d,$E);[m\1\2]

# - Return
|return $E;[X]
|return;[Q]

# - benchmarking dispatch
|nop;[ ]
|pon;[]
# #TIMED "name": op '#' + name; the JIT on the host simulator prints the
#   cycles since the previous #TIMED, everything else skips it
# #TIMED (no name): '#' + 0, only restarts the counting there
|#timed "[#]\u\*\n
|#timed[#\#00]\*\n
# #pragma TIMED "name" / #pragma TIMED: the same, but plain C: other
#   compilers ignore unknown pragmas (some warn). Other pragmas: skipped
|#pragma timed "[#]\u\*\n
|#pragma timed[#\#00]\*\n
|#pragma\*\n

# - Memory
#|free(\i);[F\1]
|free(\i);
# TODO: expression usage?
|\i=malloc($E);[M\1]
# p.f = malloc(..): into a temp, then word k   captures: 1=p 2=k 3=E 4=temp
|\i\m=malloc($E);[M\t)\1\2]

# - Statement can be a Block, or lastly Assignments
|$B|;
|$R;
|$H

# END STATEMENT

# - for loops: factored out of K (K had more than MAX_ALTS=64 alts,
#   the extra ones, R; and H = all assignments, were silently dropped)
#   "for (" is already matched by K

# memset: for(i=0; i<=n; i++) a[i]=v;  -> ACC=n+1; S i; m ptr val
#   (ACC=size, i ends at size like real C; char* only: \?\C guard,
#    \?\C = \?C now: a bare C is a literal, not the rule $C)
#   TODO: I don't think the guard is working yet!
#   captures: 1=i 2=i 3=E 4=const 1 5=i 6=ptr 7=i 8=val
#   E is left in ACC (never use \3: E's capture value is not reliable)

# TODO: memset working fine on ./ivm ./ivm-jit but NOT ./ivm-asm....?

# - memset: for (i = 0; i < n; i++) p[i] = v
#   char*: any v. int*: only 0 and -1 (all bytes the same): 2n bytes,
#   * 2 (\#02 const; the JIT makes it ASL/ROL). int* with another v: no
#   memset rule matches, a normal loop below does it.
#   scoped (for (int i = ..): no end value for i -> no S i (cheaper)
#   captures: 1=I (a rule's result is a capture too) 2=i 3=i 4=E 5=i
#             6=ptr 7=i 8=val 9=const 2
L=$I\{ \+=0; \2<$E; \2++) \i\?\C\[\2\]=\d;\}[m\6\8]
|$I\{ \+=0; \2<$E; \2++) \i\?\W\[\2\]=0;\#00\#02\}[*\9m\6\8]
|$I\{ \+=0; \2<$E; \2++) \i\?\W\[\2\]=-1;\#ff\#02\}[*\9m\6\8]
#   not scoped: i ends at n (C)
#   captures: 1=i 2=i 3=E 4=i 5=ptr 6=i 7=val 8=const 2
|\i=0; \1<$E; \1++) \i\?\C\[\1\]=\d;[S\1m\5\7]
|\i=0; \1<$E; \1++) \i\?\W\[\1\]=0;\#00\#02[S\1*\8m\5\7]
|\i=0; \1<$E; \1++) \i\?\W\[\1\]=-1;\#ff\#02[S\1*\8m\5\7]

# - dangerous: for(i=0; i<42; i++) arr[i]=i; // lol!
#|\i=0; \1<E; \1++) \i\[\1\]=\i;[m\5\7]

# for <= it's wrong size memset!
#|\i=0;[Z\1] \1<=E; \1++) \i\[\1\]=\i;[m\5\6]
#|\i=0;[Z\1] \1<=E; \1++) \i\[\1\]=\d;[m\5\6]

#|\i=0; \1<E; \1++) \i\?\C\[\1\]=\i;[m\5\7]
#|\i=0; \1<E; \1++) \i\?\C\[\1\]=\d;[m\5\7]

# for(i=0; i<n; i++) a[i]=v;   captures: 1=i 2=i 3=E 4=i 5=ptr 6=i 7=val

|\i=0; [Z\1]   \1<=\d; \1++) [\mt\1\3\x] $K [n\z\y]
|\i=\d;[C\1\2] \1<=\d; \1++) [\mt\1\4\x] $K [n\z\y]
|\i=\i;[C\1\2] \1<=\d; \1++) [\mt\1\4\x] $K [n\z\y]

# limit is a name (#define const or variable): use its slot directly, no
# copy. t/n read the limit slot every round, so a variable limit that the
# body changes behaves like C (the E[S\t] copy below is a snapshot)
|\i=0; [Z\1]   \1<=\i; \1++) [\mt\1\3\x] $K [n\z\y]
|\i=\d;[C\1\2] \1<=\i; \1++) [\mt\1\4\x] $K [n\z\y]
|\i=\i;[C\1\2] \1<=\i; \1++) [\mt\1\4\x] $K [n\z\y]

# i < lim: the 'u' loop op (exclusive), same layout as 't'
|\i=0; [Z\1]   \1<\d; \1++) [\mu\1\3\x] $K [n\z\y]
|\i=\d;[C\1\2] \1<\d; \1++) [\mu\1\4\x] $K [n\z\y]
|\i=\i;[C\1\2] \1<\d; \1++) [\mu\1\4\x] $K [n\z\y]
|\i=0; [Z\1]   \1<\i; \1++) [\mu\1\3\x] $K [n\z\y]
|\i=\d;[C\1\2] \1<\i; \1++) [\mu\1\4\x] $K [n\z\y]
|\i=\i;[C\1\2] \1<\i; \1++) [\mu\1\4\x] $K [n\z\y]


|\i=$E[S\1]; \1<=$E[S\t];  \1++) [\mt\1\5\x] $K [n\z\y]
# -- TODO: \t is wrong, it's taking a snapshot like PASCAL!
|\i=$E[S\1]; \1<$E[S\t];   \1++) [\mu\1\5\x] $K [n\z\y]

# counting-down-to-zero (very common in C)
#   (commented out: needs a down-loop op, \mu below is from before 'u' = <)
#   for (i = N; i; i--)     and   for (i = N; i > 0; i--)
# both execute the body N times when N > 0 and leave i == 0
#|\i=E[S\1]; \1;\i--)    [\mu\1\x] K[m\z\y]
#|\i=E[S\1]; \1>0;\i--)  [\mu\1\x] K[m\z\y]
#|\i=E[S\1]; \1>=1;\i--) [\mu\1\x] K[m\z\y]

# for (i = N; i--; )            // N times
# for (i = N; i-- > 0; )        // - same -
# for (i = N; --i; )            // N-1 times!
# ...
#|\i=E[S\1];\1--;)      [\mu\1\x] K[m\z\y]
#|\i=E[S\1];\1-->0;)    [\mu\1\x] K[m\z\y]
#|\i=E[S\1];--\1;)      [\mu\1\x] K[m\z\y]
#|\i=E[S\1];\1;\i--)    [\mu\1\x] K[m\z\y]
#|\i=E[S\1];\1>0;\i--)  [\mu\1\x] K[m\z\y]

# counting-down-to-zero with classic ops (no u/m)
# body runs N times for N>0, i ends at 0
# for (i = N; i--; )          and  for (i = N; i-->0; )
#   C: test the old i, then i-1; the exit path decrements too (i = -1)
|\i=$E[S\1];\1--;)     [\mL\1?G\xJ\1] $K[B\z\yJ\1]
|\i=$E[S\1];\1-->0;)   [\mL\1G\x0?G\x\w\yJ\1] $K[B\z\yJ\1]
# for (i = N; --i; )          (runs N-1 times — keep if you want it)
|\i=$E[S\1];--\1;)     [\mJ\1?G\x] $K[B\z\y]
# for (i = N; i; i--)         and  for (i = N; i>0; i--)
|\i=$E[S\1];\1;\i--)   [\mL\1?G\x] $K[J\1B\z\y]
|\i=$E[S\1];\1>0;\i--) [\mL\1G\x0?G\x\w\y] $K[J\1B\z\y]

|\i\?c=$E[s\1]; [\m]$E[?G\x] ;\1++) $K[i\4B\z\y]
|\i\?c=$E[s\1]; [\m]$E[?G\x] ;\1--) $K[j\4B\z\y]
|\i=$E[S\1]; [\m]$E[?G\x] ;\i++) $K[I\4B\z\y]
|\i=$E[S\1]; [\m]$E[?G\x] ;\i--) $K[J\4B\z\y]

|$E; [\m] $E [?G\x] ;$E) $K[B\z\y]

|\i=$E[S\1]; [\m]$E[?G\x]; \i+=\i) $K[U\1\5B\z\y]

|\i=$E[S\1]; \1<=$E[S\t]; \1++) [\mt\1\5\x] $K [n\z\y]

# END FOR


# G = Switch interior items (declarations, case/default labels, or normal statements)
# TODO: oh, I guess one could declare vars at beginning, lol, even seen
#   actually, REAL C is worse! This grammar is actually structured!
G=$V\<
|case \d:[\s1]\<
|default : [\s2] $G\<
|$K\<
|


# - Assignments
# Prefer specific forms (no peephole across jumps): COPY / Z / U / ...
# char (unsigned) vars: the value is a byte, s stores the low byte (hi 0)
#   \?c: plain c, \c would be a directive
# - if / while (l OP r): rules Y / X (K has too many alts otherwise)
Y=if ($S<=$S)[t\1\2\x] $K else[0?G\x\w\y] $K[\y]
|if ($S<=$S)[t\1\2\x] $K[\y]
|if ($S>=$S)[t\2\1\x] $K else[0?G\x\w\y] $K[\y]
|if ($S>=$S)[t\2\1\x] $K[\y]
|if ($S<$S)[u\1\2\x] $K else[0?G\x\w\y] $K[\y]
|if ($S<$S)[u\1\2\x] $K[\y]
|if ($S>$S)[u\2\1\x] $K else[0?G\x\w\y] $K[\y]
|if ($S>$S)[u\2\1\x] $K[\y]
|if ($S<=$R[S\t])[t\1\3\x] $K else[0?G\x\w\y] $K[\y]
|if ($S<=$R[S\t])[t\1\3\x] $K[\y]
|if ($S>=$R[S\t])[t\3\1\x] $K else[0?G\x\w\y] $K[\y]
|if ($S>=$R[S\t])[t\3\1\x] $K[\y]
|if ($S<$R[S\t])[u\1\3\x] $K else[0?G\x\w\y] $K[\y]
|if ($S<$R[S\t])[u\1\3\x] $K[\y]
|if ($S>$R[S\t])[u\3\1\x] $K else[0?G\x\w\y] $K[\y]
|if ($S>$R[S\t])[u\3\1\x] $K[\y]

X=while ([\m]$S<=$S) [t\1\2\x] $K[B\z\y]
|while ([\m]$S>=$S) [t\2\1\x] $K[B\z\y]
|while ([\m]$S<$S) [u\1\2\x] $K[B\z\y]
|while ([\m]$S>$S) [u\2\1\x] $K[B\z\y]
|while ([\m]$S<=$R[S\t]) [t\1\3\x] $K[B\z\y]
|while ([\m]$S>=$R[S\t]) [t\3\1\x] $K[B\z\y]
|while ([\m]$S<$R[S\t]) [u\1\3\x] $K[B\z\y]
|while ([\m]$S>$R[S\t]) [u\3\1\x] $K[B\z\y]

# swap: t = a[i]; a[i] = a[j]; a[j] = t;  (int*)  -> A a i j, S t
#   captures (back references count too): 1=t 2=a 3=i 4=a 5=i 6=a 7=j.
#   A leaves the old a[i] in ACC: t is right after it
H=\i=\i\?\W\[\i\]; \2\[\3\]=\2\[\i\]; \2\[\7\]=\1;[A\2\3\7S\1]
|\i\?c++;[i\1]
|++\i\?c;[i\1]
|\i\?c--;[j\1]
|--\i\?c;[j\1]
|\i\?c=\1+1;[i\1]
|\i\?c=\1-1;[j\1]
|\i\?c+=$E;[+\1s\1]
|\i\?c=0;[Z\1]
|\i\?c=$E;[s\1]
# int* (word pointer): ++ -- move one element = 2 bytes
#   captures: 1=p   (+=: 1=p 2=n)
|\i\?\W++;[H\1]
|++\i\?\W;[H\1]
|\i\?\W--;[J\1J\1]
|--\i\?\W;[J\1J\1]
|\i\?\W+=1;[H\1]
|\i\?\W+=2;[H\1H\1]
|\i\?\W+=$S;[L\2+\2+\1S\1]
|\i\?\W=\1+1;[H\1]
|\i\?\W=\1-1;[J\1J\1]
|\i+=\i;[U\1\2]
# int (not a pointer): += 2 is H
|\i\?w+=2;[H\1]
|\i\?w=\1+2;[H\1]
|\i\?w=2+\1;[H\1]
# += -= with any expression   captures: 1=v 2=E 3=temp
|\i\?\W+=$E;[S\t+\3+\1S\1]
|\i\?\W-=$E;[S\t+\3S\3L\1-\3S\1]
|\i\?c-=$E;[S\tL\1-\3s\1]
|\i+=$E;[+\1S\1]
|\i-=$E;[S\tL\1-\3S\1]
|\i=\1+1;[I\1]
|\i=1+\1;[I\1]
|\i=\1-1;[J\1]
# k = j + 1 / 1 + j / j + 2 / 2 + j / j - 1 (int k): copy, then I H J
#   (C k j + I k: 2 ops, 5 B, no + const). After k = k + 1 above
|\i\?w=\i+1;[C\1\2I\1]
|\i\?w=1+\i;[C\1\2I\1]
|\i\?w=\i+2;[C\1\2H\1]
|\i\?w=2+\i;[C\1\2H\1]
|\i\?w=\i-1;[C\1\2J\1]
|* \i\?\C=$E;[w\1]
|* \i=$E;[!\1]

# p[i]: char* -> byte ops [ ], int* -> word ops ( ) (\?\C = \?C now);
#   anything else (an int used as pointer): bytes
|\i\?\C\[$S\]=$E;[\]\1\2]
|\i\?\W\[$S\]=$E;[)\1\2]
|\i\[$S\]=$E;[\]\1\2]
# p[expr] = ...: index into a temp first   captures: 1=p 2=index 3=temp 4=value
|\i\?\C\[$E[S\j]\]=$E;[\]\1\3]
|\i\?\W\[$E[S\j]\]=$E;[)\1\3]
|\i\[$E[S\j]\]=$E;[\]\1\3]
# p.f p->f   captures: 1=p 2=k 3=E / const 1 (4: E in a temp, only read)
|\i\m=$E;[)\1\2]
|\i\m+=$E;[S\j(\1\2+\4)\1\2]
|\i\m++;\#01[(\1\2+\3)\1\2]
|\i\m--;\#01[(\1\2-\3)\1\2]

|\i=0;[Z\1]
|\i=$S+$S;[L\2+\3S\1]
|\i=$S-$S;[L\2-\3S\1]
# C dest src — mem[dest]=mem[src]; ACC=value  (var=var, var=const-slot, var=string-slot)
|\i=\i;[C\1\2]
|\i=$S;[C\1\2]
|\i++;[I\1]
|++\i;[I\1]
|\i--;[J\1]
|--\i;[J\1]
|\i=$E;[S\1]

# - PrintF support (ingore formatting, lol)
W=,$J\<|
J="%u\\\\n"|"%d\\\\n"|"%s\\\\n"|"%s"|"%u "|"%d "|"%u"|"%d"|"["]\u|$E[.]

# - Expressions
E=\i+=\i [U\1\2]

# - Casting
#|(I)E  - not work (type annotation require a symbol?
#|(T*)E - not work
|(char*)$E
|(int*) $E
|(word*)$E
# (char): binds tighter than the operators: (char)x + y casts x only
|(char)$R\#ff[&\2]$O
|(char)$S\#ff[\l1&\2]$O

|$R$O
|$S[\l1]$O

# - Function call
R=getchar()[K]
|\i($Z)[\v]

# - Dereferencing points
#   *charptr++ (TODO: block for intptr, put guard/other gen)
|* \i\?\W++[@\1S\tH\1L\2]
|* \i++['\1]
#   *intptr    (TODO: block for charptr, put guard/other gen)
|* \i\?\C[r\1]
|* \i[@\1]

|\i\?\C\[$S\][\[\1\2]
|\i\?\W\[$S\][(\1\2]
|\i\[$S\][\[\1\2]
# p[expr]   captures: 1=p 2=index 3=temp
|\i\?\C\[$E\][S\j\[\1\3]
|\i\?\W\[$E\][S\j(\1\3]
|\i\[$E\][S\j\[\1\3]
# p.f p->f: word k   captures: 1=p 2=k
|\i\m[(\1\2]

# - Parens
|($E)

# - Not: binds tight (!a + b is (!a) + b): an operand, not an E
|! $R[?]
|! $S[\l1?]

# - Simple Expression: \s = string const, \d = number
# sizeof: by the type's guard: char 1, int / word / any pointer 2 (\#xx:
# the result is the const xx); a static array: its size (\$)
S=\d|sizeof(struct \i\$)|sizeof($T\?c)\#01|sizeof($T)\#02|sizeof(\i\$)|sizeof(\i\?c)\#01|sizeof(\i)\#02|\s|\i

# - List of expressions (limited, TODO: get rid of?)
# TODO: think it'll parse E twice?
Z=$E,[S\k]\<|$E|

# Binary operators, left to right (no temps for precedence): an operator
#   may only be followed by one of the same or a looser level, C's
#   precedence then holds. \> starts a level, \< goes back to it. A tighter
#   one after it does not parse: a + b * c needs a + (b * c) (a * b + c is
#   fine). The levels, tightest first: * / %, + -, << >>, < <= > >=,
#   == !=, &, ^, | (C's & ^ | are below ==: a & b == c does not parse)
# With an R right operand: the left one spilled (\j), R in ACC; - / % <<
#   >>: R into a temp, the left loaded
O=
|\>* [S\j] $R[*\a1]\<
|/ [S\j] $R[S\tL\a1/\a3]\<
|% [S\j] $R[S\tL\a1%\a3]\<
|* $S[*\a1]\<
|/ $S[/\a1]\<
|% $S[%\a1]\<
|\>+ [S\j] $R[+\a1]\<
|- [S\j] $R[S\tL\a1-\a3]\<
|+ $S[+\a1]\<
|- $S[-\a1]\<
|\><<[S\j] $R[S\tL\a1\{\a3]\<
|>>[S\j] $R[S\tL\a1\}\a3]\<
|<<$S[\{\a1]\<
|>>$S[\}\a1]\<
# compare with an R: left spilled, R in ACC, compare swapped (no 2nd temp):
#   l <= r  =  !(r < l)    l >= r  =  !(r > l)    l < r  =  r > l
|\><=[S\j] $R[<\a1?]\<
|>=[S\j] $R[>\a1?]\<
|< [S\j] $R[>\a1]\<
|> [S\j] $R[<\a1]\<
|<=$S[>\a1?]\<
|>=$S[<\a1?]\<
|< $S[<\a1]\<
|> $S[>\a1]\<
|\>!=[S\j] $R[=\a1?]\<
|==[S\j] $R[=\a1]\<
|!=$S[=\a1?]\<
|==$S[=\a1]\<
|\>& [S\j] $R[&\a1]\<
|& $S[&\a1]\<
|\>^ [S\j] $R[^\a1]\<
|^ $S[^\a1]\<
|\>\|[S\j] $R[|\a1]\<
|\|$S[|\a1]\<
|
.


-- Legend
.   end of rules
|   at line start = continue previous rule
$X  rule call: $A..$Z, and $a..$z for minor helper rules (best: the
    same letter as the rule they help); defined by X= at the line start.
    A plain letter (any case) in a pattern is a literal

Tokens:
  \i  ident in scope -> slot (call vector remembered in the frame for \v)
  \+  declare ident -> slot
  \f  declare function ident: name = ret-value cell of a new frame
      (base+0 ret addr, +1 ret value, +2 prev fp, +3 last param) + vector index
  \p  declare parameter: slot base+4+n (a struct: field n)
  \q  end of a struct (\f \{ params): instead of \}, see rule d
  \m  .f ->f: member f of the struct of the last \i: const k
-- TODO: conflict with \r set mark on REGISTER var
  \r  end of params (no input): last param moves to base+3 (JSR stores ACC there)

  \d  number -> const address (CONST_TOP down, via lit_addr)
  \s  string (match only)
  \*c skip input up to and including the next c (\*\n: rest of line;
      write \*\[ \*\| for [ |)
  \u  emit string bytes + \0 (opening " already matched; ["] emits the " opcode)

Control:
  \o    commit, truncate input, no use backtrace beyond here
  \{ \} scope  start end
  \> \< tail-till-here tail-recurse rule (till \> or first alt)
  \#xx  result := hex xx  (same as \d having matched that number)
  \xHH  match the byte HH exactly (no ws skipped)
  \@    the ident just declared (\1) becomes a static array of \2 elements
  \$    the ident \i matched is a static array: result := its size (bytes)
  \:    an initialized array: start its data (\2: the size, if given)
  \,    add the last capture (a const) as an element
  \.    end it: zeros up to the size; the ident (\1) points to it
  \=n   result := capture n

Generate:
  [..]     production  (-v prints GEN only when alt commits)
           a bare | inside [..] is literal, not an alternative separator
           [] alone = no code, result := ACC
  \1 - \9  capture byte (address slot index)
  \aN      force address (spill ACC to temp, BEFORE the production's bytes)
  \lN      load capture N into ACC (nothing if it already is ACC)
  \t       allocate temp, emit its slot, record it as a capture
  \j       the same for a temp that is only read: after a plain load
           (\lN) the S is dropped and that slot is the capture
  \v       emit 0xC0|vec for the function matched by \i in this rule
  \k       emit param slot of the next call argument (rule Z)
  \x       emit jump placeholder, push on patch stack
  \xHH     emit the byte HH (\x then two hex digits; \#xx too)
  \y       patch top placeholder to jump to here    \w swap top two
  \m       mark loop start    \z emit backward delta to the mark
  \[ \]    emit a literal [ or ]

  [;]      function return opcode (alt: Q, X: after body)




