# Hassign Intcharetc Jprintone Kstatements Massvardecl
# O Program 
# Q,arguments RstartvalueofE Simpleval
# Type Uvardecl Var WprintitemJ Z H
#
# -- letters free: G L N X Y

# Features TODO/missing:
# - casting, advanced pointer stuff
# - * is char, and [] is int, p++ is for char
# - do ... while continue break
# - switch ... case
# - label: goto label;
# - actual include (ignored for now!)
# - const arrays (initilized)
# - operands have no priorites; left-to-right
# - printf very limited; putchar putz puts putn putnl nl


# =============================================

# - comment spec
#= /* */
#= //

# - Program starts with P
P=D

D=#include <\+.h>\n\o\<|#define \c\+ \d[\g]\o|#define \c\+ \s[\g]\o
|#include "\+.h"\n\o\<
|#include <\+.c>\n\o\<
|V\o\<|F\o\<|

# - Declarations: optional register\r -> REGISTER slot 0..31
# -O: REGISTER 0..31, other globals 32..95, frames at 96+
V=const\c T M;|register\r T M;|T M;
M=\+=S[\g]U|\+=E[S\1]U|\+U|

# - TODO: deep recursion might be bad...
U=,M|

# - TODO: why I^* - pascal artifact?
T=I *\'^|I^*\'^|I
I=int\'w|word\'w|void\'w|char\'c|unsigned int\'w|unsigned char\'c

# - Function/Args definition
F=\oT \f\{(A)\r B \}[X]\o
A=void|T \pQ|
Q=,A|

# - Block
B={ \{ C } \}
C=V\<|K\<|

# - Statements — keywords / specific forms first
K=if (E)[?G\x] K else[0?G\x\w\y] K[\y]
|if (E)[?G\x] K[\y]

# - Switch
# \sXX - not implemented cannot enable
#|switch (E) [\s1 G\x] { \{ G \} [\y\s4] }\<
# TODO: make work: for & while continue; ?
#|break;[J\s3]\<

# - Loops
|for (\i=0; [Z\1]   \1<=\d; \1++) [\mi\1\3\x] K [n\z\y]
|for (\i=\d;[C\1\2] \1<=\d; \1++) [\mi\1\4\x] K [n\z\y]
|for (\i=\i;[C\1\2] \1<=\d; \1++) [\mi\1\4\x] K [n\z\y]

|for (\i=0; [Z\1]   \1<=\i; \1++) [\mi\1\3\x] K [n\z\y]
|for (\i=\d;[C\1\2] \1<=\i; \1++) [\mi\1\4\x] K [n\z\y]
|for (\i=\i;[C\1\2] \1<=\i; \1++) [\mi\1\4\x] K [n\z\y]

# TODO: - make same for vars, but can we really?
#   need new op instead of 'i' (j is down) so 'k' maybe (and 'l')
#   should rewrite so only 'n' is needed, it can figure out the
#   op, and or run the same code (jump back and forth is ok)
#   These are 144 bytes (i+n so should minimize, at slight cost)

|for (\i=0; [Z\1]   \1<\d[\eS\t]; \1++) [\mi\1\4\x] K [n\z\y]
|for (\i=\d;[C\1\2] \1<\d[\eS\t]; \1++) [\mi\1\5\x] K [n\z\y]
|for (\i=\i;[C\1\2] \1<\d[\eS\t]; \1++) [\mi\1\5\x] K [n\z\y]


|for (\i=E[S\1]; \1<=E[S\t];  \1++) [\mi\1\5\x] K [n\z\y]
|for (\i=E[S\1]; \1<E[\eS\t]; \1++) [\mi\1\5\x] K [n\z\y]

# counting-down-to-zero (very common in C)
#   for (i = N; i; i--)     and   for (i = N; i > 0; i--)
# both execute the body N times when N > 0 and leave i == 0
|for (\i=E[S\1]; \1;\i--)    [\mj\1\x] K[m\z\y]
|for (\i=E[S\1]; \1>0;\i--)  [\mj\1\x] K[m\z\y]
|for (\i=E[S\1]; \1>=1;\i--) [\mj\1\x] K[m\z\y]

# for (i = N; i--; )            // N times
# for (i = N; i-- > 0; )        // - same -
# for (i = N; --i; )            // N-1 times!
# ...
#|for (\i=E[S\1];\1--;)      [\mj\1\x] K[m\z\y]
#|for (\i=E[S\1];\1-->0;)    [\mj\1\x] K[m\z\y]
#|for (\i=E[S\1];--\1;)      [\mj\1\x] K[m\z\y]
#|for (\i=E[S\1];\1;\i--)    [\mj\1\x] K[m\z\y]
#|for (\i=E[S\1];\1>0;\i--)  [\mj\1\x] K[m\z\y]

# counting-down-to-zero with classic ops (no j/m)
# body runs N times for N>0, i ends at 0
# for (i = N; i--; )          and  for (i = N; i-->0; )
|for (\i=E[S\1];\1--;)     [\mL\1G\x] K[J\1B\z\y]
|for (\i=E[S\1];\1-->0;)   [\mL\1G\x] K[J\1B\z\y]
# for (i = N; --i; )          (runs N-1 times — keep if you want it)
|for (\i=E[S\1];--\1;)     [\mL\1G\x] K[J\1B\z\y]
# for (i = N; i; i--)         and  for (i = N; i>0; i--)
|for (\i=E[S\1];\1;\i--)   [\mL\1G\x] K[J\1B\z\y]
|for (\i=E[S\1];\1>0;\i--) [\mL\1G\x] K[J\1B\z\y]

|for (\i=E[S\1]; [\m]E[?G\x] ;\i++) K[I\4B\z\y]
|for (\i=E[S\1]; [\m]E[?G\x] ;\i--) K[J\4B\z\y]

|for (E; [\m] E [?G\x] ;E) K[B\z\y]

|for (\i=E[S\1]; [\m]E[?G\x]; \i+=\i[U\1\5]) K[B\z\y]

|for (\i=E[S\1]; \1<=E[S\t]; \1++) [\mi\1\5\x] K [n\z\y]

|while ([\m]E) [?G\x] K[B\z\y]


# - Input / Output
# TODO: put these as prefix starting with pX X many alts
|putchar('\\n');[N]
|putchar(\d);[O\c1]
|putchar(\i);[L\1E]
|putchar(E);[E]

|puts("["]\u);[N]
|puts(\i);[\1PN]

|fputs("["]\u,stdout);
|fputs(\i,stdout);[\1P]

# single string constant - common
|printf("["]\u);

|printf("%s",\i);[L\1P]

|printf("%u\ ",E);[.O ]
|printf("%d\ ",E);[.O ]

|printf("%u\\n",E);[.N]
|printf("%d\\n",E);[.N]

|printf("%d",E);[.]
|printf("%u",E);[.]

|printf(\i);[L\1P]

# - TODO: lol?
|printf("%u%u%u\\\\n",E,E,E);[...N]
|printf("%u%u%u",E,E,E);[...]
|printf("\\"%s\\" has %d characters\\n",\i,\i(Z)[\v]);[S\tL\1P" has \#00L\3.N]

|printf(E);[P]

|putz("["]\u);
|putz(E);[P]
|putnl(E);[.N]
|putn(E);[.O ]
|nl();[N]

# - TODO: vararg printf?
#|printf(JW);

# - a dummy catch all - WRONG!
|printf("["]\u, E);[.]

# - Return
|return E;[X]
|return;[Q]

# - benchmarking dispatch
|nop;[ ]
|pon;[]

# - Memory
|free(\i);[F\1]
|\i=malloc(E);[M\1]

# - Statement can be a Block, or lastly Assignments
|B|;
|R;
|H

# END STATEMENT

# G = Switch interior items (declarations, case/default labels, or normal statements)
# TODO: oh, I guess one could declare vars at beginning, lol, even seen
#   actually, REAL C is worse! This grammar is actually structured!
G=V\<
|case \d:[\s1]\<
|default : [\s2] G\<
|K\<
|


# - Assignments
# Prefer specific forms (no peephole across jumps): COPY / Z / U / ...
H=\i+=\i;[U\1\2]
|\i=\1+1;[I\1]
|\i=1+\1;[I\1]
|\i=\1-1;[J\1]
|* \i=E;[!\1]
|\i\[S\]=E;[)\1\2]
|\i=0;[Z\1]
|\i=S+S;[L\2+\3S\1]
|\i=S-S;[L\2-\3S\1]
# C dest src — mem[dest]=mem[src]; ACC=value  (var=var, var=const-slot, var=string-slot)
|\i=\i;[C\1\2]
|\i=S;[C\1\2]
|\i++;[I\1]
|++\i;[I\1]
|\i--;[J\1]
|--\i;[J\1]
|\i=E;[S\1]

# - PrintF support (ingore formatting, lol)
W=,J\<|
J="%u\\\\n"|"%d\\\\n"|"%s\\\\n"|"%s"|"%u "|"%d "|"%u"|"%d"|"["]\u|E[.]

# - Expressions
E=\i+=\i [U\1\2]

# - Casting
#|(I)E  - not work (type annotation require a symbol?
#|(T*)E - not work
|(char*)E
|(int*) E
|(word*)E
|(char)E[&\xff] # TODO: doesn't work

|RO
|S[\l1]O

# - Function call
R=\i(Z)[\v]

# - Dereferencing points
#   *charptr++ (TODO: block for intptr, put guard/other gen)
|* \i++['\1]
#   *intptr    (TODO: block for charptr, put guard/other gen)
|* \i[@\1]

|\i\[S\][(\1\2]

# - Parens
|(E)

# - Not
|! E[?]

# - Simple Expression: \s = string const, \d = number
S=\d|sizeof(T)\z|sizeof(\i)\z|\s|\i

# - List of expressions (limited, TODO: get rid of?)
# TODO: think it'll parse E twice?
Z=E,[S\k]\<|E|

O=
|<<[S\t] R [[\a1]\<
|>>[S\t] R\a1]\<
|!=[S\t] R[=\a1?]\<
|==[S\t] R[=\a1]\<
|+ [S\t] R[+\a1]\<
|- [S\t] R[S\tL\a1-\a3]\<
|* [S\t] R[*\a1]\<
|/ [S\t] R[S\tL\a1/\a3]\<
|& [S\t] R[&\a1]\<
|\|[S\t] R[|\a1]\<
|^ [S\t] R[^\a1]\<
|<=[S\t] R[S\tL\a1>\a3?]\<
|>=[S\t] R[S\tL\a1<\a3?]\<
|< [S\t] R[S\tL\a1<\a3]\<
|> [S\t] R[S\tL\a1>\a3]\<
|<<S[\[\a1]\<
|>>S[\]\a1]\<
|!=S[=\a1?]\<
|==S[=\a1]\<
|+ S[+\a1]\<
|- S[-\a1]\<
|* S[*\a1]\<
|/ S[/\a1]\<
|& S[&\a1]\<
|\|S[|\a1]\<
|^ S[^\a1]\<
|<=S[>\a1?]\<
|>=S[<\a1?]\<
|< S[<\a1]\<
|> S[>\a1]\<
|
.


-- Legend
.   end of rules
|   at line start = continue previous rule

Tokens:
  \i  ident in scope -> slot (call vector remembered in the frame for \v)
  \+  declare ident -> slot
  \f  declare function ident: name = ret-value cell of a new frame
      (base+0 ret addr, +1 ret value, +2 prev fp, +3 last param) + vector index
  \p  declare parameter: slot base+4+n
-- TODO: conflict with \r set mark on REGISTER var
  \r  end of params (no input): last param moves to base+3 (JSR stores ACC there)

  \d  number -> const address (CONST_TOP down, via lit_addr)
  \s  string (match only)
  \u  emit string bytes + \0 (opening " already matched; ["] emits the " opcode)

Control:
  \o    commit, truncate input, no use backtrace beyond here
  \{ \} scope  start end
  \> \< tail-till-here tail-recurse rule (till \> or first alt)
  \#xx  result := hex xx  (same as \d having matched that number)
  \=n   result := capture n

Generate:
  [..]     production  (-v prints GEN only when alt commits)
           a bare | inside [..] is literal, not an alternative separator
           [] alone = no code, result := ACC
  \1 - \9  capture byte (address slot index)
  \aN      force address (spill ACC to temp, BEFORE the production's bytes)
  \lN      load capture N into ACC (nothing if it already is ACC)
  \t       allocate temp, emit its slot, record it as a capture
  \v       emit 0xC0|vec for the function matched by \i in this rule
  \k       emit param slot of the next call argument (rule Z)
  \x       emit jump placeholder, push on patch stack
  \y       patch top placeholder to jump to here    \w swap top two
  \m       mark loop start    \z emit backward delta to the mark
  \[ \]    emit a literal [ or ]

  [;]      function return opcode (alt: Q, X: after body)




--- TODO: revsit / implement

Switch:

In C, a switch body { ... } is simply a sequence of statements interspersed with case <const>: and default: labels, plus break; statements.

3. How the 4 Tiny Semantic Actions (\s1–\s4) Drive Your "Swiss Cheese" 'k' Emitter

Because your parser is single-pass and backtracks on failed alternatives, keeping a tiny compile-time switch_stack[MAX_SWITCH_DEPTH] (with sp) handles nested switches and backtracking cleanly:

1. [\s0] (on switch (E) right before [G\x]):
	• Push a new SwitchFrame onto switch_stack[sp++].
	• Allocate one relocatable break_const_slot from your constant
          pool (CONST_TOP down) and clear the frame's (const_val,
          code_offset) list.
	• Emit [G\x] (jumps over all case bodies straight to the
          bottom 'k' table).

2. [\s1] (on case N :):
	• Record (N, current_code_offset) in switch_stack[sp-1].
	• (If current_code_offset - first_case_offset > 220, you can
          optionally flush a 'k' chunk right here and emit a fresh
          [G\x] for the next chunk so back never overflows 255!)

3. [\s2] (on default :):

	• Record default_offset = current_code_offset in
          switch_stack[sp-1].

4. [J\s3] (on break;):
	• Emit J followed by switch_stack[sp-1].break_const_slot (2
          bytes total!).
	• (Note: If you also want break; inside for/while loops later,
          \s3 simply checks whether the innermost enclosing block is a
          switch or a loop!)

5. [\y\s4] (at closing }):
	• [\y] patches the top [G\x] jump to land right here at the
          start of the 'k' dispatch block.
	• [\s4] sorts the recorded (val, offset) pairs, splits them
          into dense (span <= 2 * count, 0-filled holes!) vs. sparse
          (0xff) 'k' chunks, and emits each 'k' instruction using back
          = k_base_offset - case_offset.
	• If default_offset was recorded, emit a final B
          <back_to_default> (or GW if >255 bytes) right after the last
          'k' chunk.
	• Write current_code_offset (the exact end of the switch!)
          into break_const_slot (marked for load-time relocation!),
          and pop sp--.
