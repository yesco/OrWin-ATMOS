# -- BNF grammar for tpi.c C implementation targeting Custom Bytecode
# K = statement, S = simple primary (address), R = ACC primary (call, (E), not)
# O = op chain, E = expression

# Program is just a list of declarations
P=D
D=V\<|F\<|#include <\+.h>\n|#includee <\+.c>\n|
V=T M;\<|
M=\+:Q|

# \f = declare function, \p = parameter, \r = end of params
# [X] emits the 'return ACC' opcode at the end of the function body
F=T \f(A)\r HB[X]
A=T \pQ|
Q=,A|
T=I^*|I
I=int|word
H=V|

# C uses blocks bounded by { }
N=\}|
B=\{ C N
C=K\<|

# -- keyword statements
# - if: [?G\x] jump over THEN when false; else: [0?G\x\w\y] jump over ELSE, patch THEN jump
# - for: ctrl and limit stored, [\m..] loop start, G exit / B back
K=if (E)[?G\x] K else[0?G\x\w\y] K[\y]|if (E)[?G\x] K[\y]
|for (\i=E[S\1]; \i<=E[S\t]; \i++)[\mL\1-\4G\x] K[I\1B\z\y]

|printf("\n");[N]|printf(JW);[N]
|return E;[S\1X]|return;[Q]
|B|;
|* \i=E;[!\1]
|\i\[S\]=E;[)\1\2]
|\i=0;[Z\1]
|\i=S+S;[L\2+\3S\1]
|\i=S-S;[L\2-\3S\1]
|\i=S;[L\2S\1]
|\i=E;[S\1]

# JW: printf elements, comma-separated (W = optional ,J tail)
W=,J\<|
J=E[.]|"%d"|"%s"|"["]\S

# -- E = ACC primary or simple primary (loaded), then ops; result is always ACC
E=RO[]|S[\l1]O[]

# R = primary that leaves its value in ACC: call [\v], *p, a[i], (E), logical not
R=\i(Z)[\v]|* \i[@\1]|\i\[S\][(\1\2]|(E)[]|! E[?]

# S = simple primary -> address, no code
S=\d|sizeof(T)\#02|sizeof(\i)\#02|\i

# Z = call arguments: every arg but the last is stored to its param slot [S\k],
# the last stays in ACC (JSR stores it at fp+3)
Z=E,[S\k]\<|E|

# -- RHS in ACC (call): spill left first [S\t], then emit code
# Your engine maps shifts/bit operations directly to slots: |vv, ^vv, [vv, ]vv
O=
|+[S\t]R[+\a1]\<
|-[S\t]R[S\tL\a1-\a3]\<
|*[S\t]R[*\a1]\<
|/[S\t]R[S\tL\a1/\a3]\<
|&[S\t]R[&\a1]\<

|\|[S\t]R[|\a1]\<
|^[S\t]R[^\a1]\<
|==[S\t]R[=\a1]\<
|<[S\t]R[S\tL\a1<\a3]\<
|>[S\t]R[S\tL\a1>\a3]\<
|<<[S\t]R[[\a1]\<
|>>[S\t]R[]\a1]\<
# - simple stream modifying ACC using direct variable/address S
|+S[+\a1]\<
|-S[-\a1]\<
|*S[*\a1]\<
|/S[/\a1]\<
|&S[&\a1]\<
|^S[^\a1]\<
|==S[=\a1]\<
|<S[<\a1]\<
|>S[>\a1]\<
|<< S[\[\a1]\<
|>> S[\]\a1]\<
|
.
