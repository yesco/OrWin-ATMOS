# -- BNF grammar for tpi.c C implementation targeting Custom Bytecode
# Comment styles for the *source* language (not the BNF itself):
#= /* */
#= //
# K = statement, S = simple primary (address), R = ACC primary (call, (E), not)
# O = op chain, E = expression
#
# Zero-or-more pattern (same as tpi.bnf):
#   X=A\<|B\<|
# consuming alts end with \< ; bare empty alt is LAST and has no \<.
# Never put an empty alt under a pure \< path — that loops forever.

# Program: zero-or-more top-level declarations
P=D.

# Declarations — includes first (#), then var, then function
D=#include <\+.h>\n\<|#include "\+.h"\n\<|#include <\+.c>\n\<|V\<|F\<|

# Variable declaration: int a, b;
V=T M;
M=\+:Q|
Q=,M|

# Types
T=I^*|I
I=int|word|void

# Function: int f(int a, int b) { body }
F=T \f(A)\r B[X]
A=T \pQ|void|
Q=,A|

# C blocks { ... }
N=\}|
B=\{ C N
C=V\<|K\<|

# -- keyword statements FIRST
K=if (E)[?G\x] K else[0?G\x\w\y] K[\y]|if (E)[?G\x] K[\y]
|for (\i=E[S\1]; \i<=E[S\t]; \i++)[\mL\1-\4G\x] K[I\1B\z\y]
|printf("\n");[N]|printf(JW);[N]
|return E;[S\1X]|return;[Q]
|B|;
|* \i=E;[!\1]
|\i\[S\]=E;[)\1\2]
|\i=0;[Z\1]
|\i=S+S;[L\2+\3S\1]
|\i=S-S;[L\2-\3S\1]
|\i=S;[L\2S\1]
|\i=E;[S\1]

# printf args
W=,J\<|
J=E[.]|"%d"|"%u"|"%s"|"["]\S

# Expression
E=RO[]|S[\l1]O[]

# R = primary leaving value in ACC
R=\i(Z)[\v]|* \i[@\1]|\i\[S\][(\1\2]|(E)[]|! E[?]

# S = simple primary
S=\d|sizeof(T)\#02|sizeof(\i)\#02|\i

# Call args
Z=E,[S\k]\<|E|

# Op chain — multi-char ops before single-char
O=
|<<[S\t]R[[\a1]\<
|>>[S\t]R[]\a1]\<
|==[S\t]R[=\a1]\<
|+[S\t]R[+\a1]\<
|-[S\t]R[S\tL\a1-\a3]\<
|*[S\t]R[*\a1]\<
|/[S\t]R[S\tL\a1/\a3]\<
|&[S\t]R[&\a1]\<
|\|[S\t]R[|\a1]\<
|^[S\t]R[^\a1]\<
|<[S\t]R[S\tL\a1<\a3]\<
|>[S\t]R[S\tL\a1>\a3]\<
|<< S[\[\a1]\<
|>> S[\]\a1]\<
|==S[=\a1]\<
|+S[+\a1]\<
|-S[-\a1]\<
|*S[*\a1]\<
|/S[/\a1]\<
|&S[&\a1]\<
|\|S[|\a1]\<
|^S[^\a1]\<
|<S[<\a1]\<
|>S[>\a1]\<
|
.
