# -- BNF grammar for tpi.c C implementation targeting Custom Bytecode
#= /* */
#= //
# \{ \} = scope enter/leave only (no input). Match literal { } separately.
# Zero-or-more: X=A\<|B\<|  (empty alt LAST, no \< on empty)

P=D

D=#include <\+.h>\n\<|#include "\+.h"\n\<|#include <\+.c>\n\<|V\<|F\<|

# int a, b;
V=T M;
M=\+U|
U=,M|

T=I^*|I
I=int|word|void

# int f(...) { body }
# \{ after params opens function scope; \} before end closes it
F=T \f\{(A)\r B \}[X]
A=T \pQ|void|
Q=,A|

# blocks: literal braces + scope enter/leave
# B = {  <scope>  stmts  }  <unscope>
B={ \{ C } \}
C=V\<|K\<|

# statements — keywords first
K=if (E)[?G\x] K else[0?G\x\w\y] K[\y]|if (E)[?G\x] K[\y]
|for (\i=E[S\1]; \i<=E[S\t]; \i++)[\mL\1-\4G\x] K[I\1B\z\y]
|printf("\n");[N]|printf(JW);[N]
|return E;[S\1X]|return;[Q]
|B|;
|* \i=E;[!\1]
|\i\[S\]=E;[)\1\2]
|\i=0;[Z\1]
|\i=S+S;[L\2+\3S\1]
|\i=S-S;[L\2-\3S\1]
|\i=S;[L\2S\1]
|\i=E;[S\1]

W=,J\<|
J=E[.]|"%d"|"%u"|"%s"|"["]\S

E=RO[]|S[\l1]O[]

R=\i(Z)[\v]|* \i[@\1]|\i\[S\][(\1\2]|(E)[]|! E[?]

S=\d|sizeof(T)\#02|sizeof(\i)\#02|\i

Z=E,[S\k]\<|E|

O=
|<<[S\t]R[[\a1]\<
|>>[S\t]R[]\a1]\<
|==[S\t]R[=\a1]\<
|+[S\t]R[+\a1]\<
|-[S\t]R[S\tL\a1-\a3]\<
|*[S\t]R[*\a1]\<
|/[S\t]R[S\tL\a1/\a3]\<
|&[S\t]R[&\a1]\<
|\|[S\t]R[|\a1]\<
|^[S\t]R[^\a1]\<
|<[S\t]R[S\tL\a1<\a3]\<
|>[S\t]R[S\tL\a1>\a3]\<
|<< S[\[\a1]\<
|>> S[\]\a1]\<
|==S[=\a1]\<
|+S[+\a1]\<
|-S[-\a1]\<
|*S[*\a1]\<
|/S[/\a1]\<
|&S[&\a1]\<
|\|S[|\a1]\<
|^S[^\a1]\<
|<S[<\a1]\<
|>S[>\a1]\<
|
.
