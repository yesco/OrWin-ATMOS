A=T \pQ|void|
Q=,A|

B={ \{ C } \}
C=V\<|K\<|

K=if (E)[?G\x] K else[0?G\x\w\y] K[\y]|if (E)[?G\x] K[\y]
|for (\i=E[S\1]; \i<=E[S\t]; \i++)[\mL\1-\4G\x] K[I\1B\z\y]
|printf("%u\\\\n",E);[.N]
|printf("%d\\\\n",E);[.N]
|printf("%u ",E);[."\#20\#00]
|printf("%d ",E);[."\#20\#00]
|printf("%u%u%u\\\\n",E,E,E);[...N]
|printf("%u%u%u",E,E,E);[...]
|printf(JW);
|return E;[S\1X]|return;[Q]
|B|;
|* \i=E;[!\1]
|\i\[S\]=E;[)\1\2]
|\i=0;[Z\1]
|\i=S+S;[L\2+\3S\1]
|\i=S-S;[L\2-\3S\1]
|\i=S;[L\2S\1]
|\i=E;[S\1]

W=,J\<|
J="%u\\\\n"|"%d\\\\n"|"%s\\\\n"|"%u "|"%d "|"%u"|"%d"|"%s"|E[.]|"["]\S

E=RO[]|S[\l1]O[]
R=\i(Z)[\v]|* \i[@\1]|\i\[S\][(\1\2]|(E)[]|! E[?]
S=\d|sizeof(T)\#02|sizeof(\i)\#02|\i
Z=E,[S\k]\<|E|

O=
|<<[S\t]R[[\a1]\<
|>>[S\t]R[]\a1]\<
