#!/usr/bin/env python3
# sizes - binary sizes over the commits, newest first:
#
#   ./psizes                 the last 30 commits
#   ./psizes 100             the last 100
#   ./psizes all             all of them
#   ./psizes 50 swap expr    also run test-swap.c and test-expr.c
#
#   date-time         parse.sim   ivm.sim  ivm-asm.sim  ivm-jit.sim  # commit
#   2026-11-24 04:58     61,234    15,729       12,300       44,773  # 0213c27 MC: ...
#
# A program (PROG, PROG.c, or NAME for test-NAME.c; today's version from
# the work tree) is compiled by each commit's parse.c (as ./pc) and run on
# its ivm-asm.sim and ivm-jit.sim, two columns each, right after the date:
#
#   swap asm: 378,136 (403)    cycles (bytecode bytes, the .ivm)
#   swap jit:  33,479 (1,606)  cycles (bytes of the -tsim6502 .ivm.sim), as
#                              ./ivm-jit's SIM. Commits without -t: ~ the
#                              in place run (JIT&RUN - JIT; emitted bytes)
#
# Each commit is built from git archive in a temp dir (not the work tree),
# the 4 binaries in parallel, with today's commands (ivm-jit.sim: else with
# -DNOIVM, else the commit's own cafix). -: its sources aren't there yet,
# FAIL: didn't build. Results are cached in .sizes-cache by the sources'
# blob hashes, so a commit that changed no source costs nothing, and a
# rerun is instant.

import concurrent.futures, json, os, re, shutil, subprocess, sys, tempfile

CACHE = ".sizes-cache"

# name, files it needs, the build (sim6502.cfg: if the commit has it)
TARGETS = [
    ("parse.sim",   ["parse.c"],
     "cl65 -t sim6502 -Oirs -o parse.sim parse.c"),
    ("ivm.sim",     ["ivm.c"],
     "cl65 -Oirs {cfg} -t sim6502 -o ivm.sim ivm.c"),
    ("ivm-asm.sim", ["ivm.c", "ivm-vm.asm"],
     "cl65 -DIVMASM -Oirs {cfg} -t sim6502 -o ivm-asm.sim ivm-vm.asm ivm.c"),
    # as cafix: the lib first
    ("ivm-jit.sim", ["ivm.c"],
     "cl65 -DVERBOSE -DJIT -Oirs {cfg} -t sim6502 -o ivm-jit.sim {lib} ivm.c"),
]


def git(*a):
    return subprocess.run(["git"] + list(a), stdout=subprocess.PIPE,
                          check=True).stdout.decode()


def srckey(c):
    """Commit c's sources (top level .c .h .asm .cfg, no tests): a hash."""
    ls = git("ls-tree", c).splitlines()
    src = sorted(l.split()[2] + " " + l.split("\t")[-1] for l in ls
                 if l.split("\t")[-1].endswith((".c", ".h", ".asm", ".cfg"))
                 and not l.split("\t")[-1].startswith(("test", "man-")))
    return subprocess.run(["git", "hash-object", "--stdin"],
                          input="\n".join(src).encode(),
                          stdout=subprocess.PIPE).stdout.decode().strip()


def sh(cmd, d, timeout=600):
    """cmd's output (stdout and stderr), "" if it timed out."""
    try:
        return subprocess.run(cmd, shell=True, cwd=d, timeout=timeout,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT
                              ).stdout.decode(errors="replace")
    except subprocess.TimeoutExpired:
        return ""


def cycles(out):
    m = re.findall(r"^(\d+) cycles$", out, re.M)
    return int(m[-1]) if m else None


def run_asm(d, p):
    ivm = p + ".ivm"
    c = cycles(sh("sim65 -c ivm-asm.sim " + ivm, d))
    return [c, os.path.getsize(os.path.join(d, ivm))] if c else "FAIL"


def run_jit(d, p):
    ivm, img = p + ".ivm", p + ".ivm.sim"
    sh("sim65 -c ivm-jit.sim -j -z -tsim6502 %s -o%s" % (ivm, img), d)
    if os.path.exists(os.path.join(d, img)):
        c = cycles(sh("sim65 -c " + img, d))
        return [c, os.path.getsize(os.path.join(d, img))] if c else "FAIL"
    # no -t yet: the in place run, less the JIT itself
    j = cycles(sh("sim65 -c ivm-jit.sim -z -j " + ivm, d))
    out = sh("sim65 -c ivm-jit.sim -z " + ivm, d)
    a, b = cycles(out), re.findall(r"emitted (\d+) bytes", out)
    return [a - j, int(b[-1]), "~"] if a and j and b else "FAIL"


RUNS = {"ivm-asm.sim": run_asm, "ivm-jit.sim": run_jit}


def build1(src, name, need, cmd, progs):
    """name's size, and [(cycles, bytes) per prog] if it runs them."""
    runs = [p for p in progs if name in RUNS]
    if not all(os.path.exists(os.path.join(src, f)) for f in need):
        return "-", ["-"] * len(runs)
    d = tempfile.mkdtemp(prefix="sizes-")
    try:
        shutil.copytree(src, d, dirs_exist_ok=True)   # own dir: own ivm.o
        cfg = "-C sim6502.cfg" if os.path.exists(d + "/sim6502.cfg") else ""
        lib = "ivm-lib.asm" if os.path.exists(d + "/ivm-lib.asm") else ""
        p = subprocess.run(cmd.format(cfg=cfg, lib=lib), shell=True, cwd=d,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        f = os.path.join(d, name)
        ok = p.returncode == 0 and os.path.exists(f)
        if not ok and name == "ivm-jit.sim":
            # older commits: built with -DNOIVM, or by their own cafix (its
            # later steps may fail: the .sim is what counts)
            for alt in (cmd.replace("-DJIT", "-DNOIVM -DJIT"), "sh cafix"):
                if alt == "sh cafix" and not os.path.exists(d + "/cafix"):
                    continue
                if os.path.exists(f): os.remove(f)
                p = subprocess.run(alt.format(cfg=cfg, lib=lib), shell=True,
                                   cwd=d, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL)
                ok = os.path.exists(f) and (p.returncode == 0 or
                                            alt == "sh cafix")
                if ok: break
        if not ok:
            return "FAIL", ["FAIL"] * len(runs)
        return os.path.getsize(f), [
            RUNS[name](d, p)
            if os.path.exists(os.path.join(d, p + ".ivm")) else "FAIL"
            for p in runs]
    finally:
        shutil.rmtree(d, ignore_errors=True)


def compile_progs(src, progs):
    """The progs (copied in) to .ivm, by the commit's parse.c as ./pc."""
    if not progs or not os.path.exists(src + "/parse.c"):
        return
    for p in progs:
        shutil.copy(p, os.path.join(src, os.path.basename(p)))
    sh("clang -DSYMS -DRUN -DVERBOSE -O3 parse.c -o parse.x", src)
    for p in progs:
        b = os.path.basename(p)[:-2]
        for opt in ("-O ", ""):      # older ones: no -O
            sh("./parse.x %s-v c.bnf %s.c" % (opt, b), src, 300)
            if os.path.exists(os.path.join(src, b + ".ivm")):
                break


def build(c, progs):
    """[sizes per target], {prog: [asm, jit]}"""
    src = tempfile.mkdtemp(prefix="sizes-src-")
    try:
        tar = subprocess.run(["git", "archive", c], stdout=subprocess.PIPE,
                             check=True).stdout
        subprocess.run(["tar", "-x", "-C", src], input=tar, check=True)
        compile_progs(src, progs)
        names = [os.path.basename(p)[:-2] for p in progs]
        with concurrent.futures.ThreadPoolExecutor(len(TARGETS)) as ex:
            r = list(ex.map(lambda t: build1(src, *t, names), TARGETS))
        res = {p: [None, None] for p in progs}
        for t, (size, runs) in zip(TARGETS, r):
            for p, v in zip(progs, runs):
                res[p][t[0] == "ivm-jit.sim"] = v
        return [size for size, _ in r], res
    finally:
        shutil.rmtree(src, ignore_errors=True)


def cell(v):
    if isinstance(v, list):    # [cycles, bytes] or [cycles, bytes, "~"]
        return "{:,} ({:,}){}".format(v[0], v[1], "".join(v[2:]) or " ")
    return "{:,}".format(v) if isinstance(v, int) else v


def blob(f):
    return subprocess.run(["git", "hash-object", f], stdout=subprocess.PIPE
                          ).stdout.decode().strip()


def prog(a):
    """PROG, PROG.c, PROG.ivm, or NAME for test-NAME.c (as ./ptest)"""
    b = re.sub(r"\.[^./]*$", "", a)
    for f in ("test-%s.c" % b, b + ".c"):
        if os.path.exists(f):
            return f
    sys.exit("%%Error: psizes: no %s.c (or test-%s.c)" % (b, b))


def main():
    args = sys.argv[1:]
    n = args.pop(0) if args and (args[0] == "all" or args[0].isdigit()) \
        else "30"
    progs = [prog(a) for a in args]
    log = git("log", "--format=%H\t%h\t%ad\t%s",
              "--date=format:%Y-%m-%d %H:%M",
              *([] if n == "all" else ["-n", n]))
    try:
        cache = json.load(open(CACHE))
    except (OSError, ValueError):
        cache = {}

    # a prog's results: by the commit's sources, c.bnf and the prog itself
    pkeys = {p: blob(p) for p in progs}
    heads = ["%s %s" % (re.sub(r"^test-", "", p[:-2]), m)
             for p in progs for m in ("asm", "jit")]
    pw = [max(18, len(h) + 2) for h in heads]
    w = [max(12, len(t[0]) + 2) for t in TARGETS]
    print("%-16s " % "date-time" +
          "".join("%*s" % (wi, h) for wi, h in zip(pw, heads)) +
          "".join("%*s" % (wi, t[0]) for wi, t in zip(w, TARGETS)) +
          "  # commit", flush=True)
    for line in log.splitlines():
        full, short, date, subj = line.split("\t", 3)
        k = srckey(full)
        bnf = subprocess.run(["git", "rev-parse", "-q", "--verify",
                              full + ":c.bnf"], stdout=subprocess.PIPE
                             ).stdout.decode().strip()
        pk = {p: "%s %s %s" % (k, bnf, pkeys[p]) for p in progs}
        todo = [p for p in progs if pk[p] not in cache]
        if k not in cache or todo:
            sizes, res = build(full, todo)
            cache[k] = sizes
            for p in todo:
                cache[pk[p]] = res[p]
            with open(CACHE, "w") as f:
                json.dump(cache, f)
        print("%-16s " % date +
              "".join("%*s" % (wi, cell(v)) for wi, v in
                      zip(pw, [v for p in progs for v in cache[pk[p]]])) +
              "".join("%*s" % (wi, cell(v)) for wi, v in zip(w, cache[k])) +
              "  # %s %s" % (short, subj), flush=True)


main()
