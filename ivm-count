. ./deps   # stale: rebuild only when a source changed

name=$1
case "${name##*/}" in ?*.*) name="${name%.*}";; esac  # PROG, PROG.c, PROG.ivm all ok

if stale ivm-count.x $IVM_SRC ivm-count; then
  clang -DCOUNTOPS -g ivm.c -o ivm-count.x || exit 1
fi

time ./ivm-count.x $name.ivm | tee $name.count

echo
echo
ls -ugGlf ivm-count.x $name.ivm 2>/dev/null
echo
echo "=== ivm.c: `./wcode ivm.c` LOC ==="
echo

