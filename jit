name=$1
case "${name##*/}" in ?*.*) name="${name%.*}";; esac  # PROG, PROG.c, PROG.ivm all ok
shift
echo "ARGS: $*"

. ./deps   # stale: rebuild only when a source changed
if stale ivm-jit.x $IVM_SRC jit; then
  clang -DVERBOSE -DJIT -g ivm.c -o ivm-jit.x || exit 1
fi
time ./ivm-jit.x $name.ivm

