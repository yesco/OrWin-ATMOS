name=$1
case "${name##*/}" in ?*.*) name="${name%.*}";; esac  # PROG, PROG.c, PROG.ivm all ok
shift
echo "ARGS: $*"

. ./deps   # stale: rebuild only when a source changed
if stale ivm-jit.x $IVM_SRC jit; then
  clang -DMEMMAP -DVERBOSE -DJIT -g ivm.c -o ivm-jit.x || exit 1
fi

# -o: an image for the target (-t sim6502|atmos), ivm-lib from mklib's .bin
#   ./jit test-swap -z -otest-swap.sim      ./jit test-swap -tatmos -ox.tap
if stale ivm-lib-sim6502.bin ivm-lib.asm mklib; then ./mklib || exit 1; fi

time ./ivm-jit.x -tsim6502 -z -o$name.sim $name.ivm $*
time ./ivm-jit.x -tatmos   -z -o$name.tap $name.ivm $*

echo
echo "--- SIMRUN ---"
sim65 -c $name.sim | tee $name.sim.log
echo "--- ENDRUN ---"
echo

run=$(cat $name.sim.log | grep cycles | sed 's/ cycles//')

cp $name.tap ~/ORIC/

echo
echo
./oric $name

echo
echo
echo "============================================"
echo
echo "SIMRUN      : $run"
echo

echo
echo
ls -ugGlf $name.ivm $name.sim $name.tap 2>/dev/null
echo
echo "=== ivm.c: `./wcode ivm.c` LOC ==="
echo "=== jit c: `./wcode ivm-jit.c` LOC ==="
echo "=== cpu c: `./wcode cpu6502.c` LOC ==="
echo

