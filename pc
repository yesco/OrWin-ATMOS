# Usage: ./pc [test-char] [-c]   # defaults to test(.c); -c: don't run it

if [ -z "$1" ]; then
    name="test"
else
    name="$1"
    case "${name##*/}" in ?*.*) name="${name%.*}";; esac  # PROG, PROG.c, PROG.ivm all ok
fi

rm $name.ivm 2>/dev/null


. ./deps   # stale: rebuild only when a source changed
if stale parse.x $PARSE_SRC pc; then
  clang -DSYMS -DRUN -DVERBOSE -O3 parse.c -o parse.x || exit 1
fi

shift 2>/dev/null   # the rest: parse.x options, e.g. -c: don't run it
time ./parse.x -O -v "$@" c.bnf $name.c

echo
echo "=== $name.c: `./wcode $name.c` LOC ==="
echo "=== parse.c: `./wcode parse.c` LOC ==="
echo "=== $name.c: `./wcode $name.c` LOC ==="
echo
ls -ugGlf $name.c $name.ivm 2>/dev/null
echo
