name=$1
case "${name##*/}" in ?*.*) name="${name%.*}";; esac  # PROG, PROG.c, PROG.ivm all ok
echo "NAME: $name"

. ./deps   # stale: rebuild only when a source changed
rm -f $name.ivm

echo "--oscar build--"
#./oscar -v2 -dRUN -dOSCAR64 -dNOFLOAT -dNOLONG -Os -o=parse.prg parse.c 
# the grammar built in (#embed c.bnf.bin): no file to load
if stale bnf2bin.x bnf2bin.c parse-oscar; then
  clang -O2 bnf2bin.c -o bnf2bin.x || exit 1
fi
if stale c.bnf.bin c.bnf bnf2bin.x; then
  ./bnf2bin.x c.bnf || exit 1
fi
./oscar -Os -dOSCAR64 -dNOFLOAT -dNOLONG -dBNF_EMBED parse.c
ls -l parse.prg

mv parse.asm parse.oscar.s

echo

ls -ugGlf parse.prg parse.sim parse.lst parse-run.sim $name.ivm 2>/dev/null
echo
echo "=== parse.c: `./wcode parse.c` LOC ==="
echo
