# -- BNF grammar for tpi.c PASCAL implementation
# K = statement, S = simple primary (address), O = op chain, E = expression
P=program \+;DB.
D=V\<|F\<|
V=var M
M=\+:T;\<|
F=function \+\{(A):T;HB\}
A=\+:T,\<|\+:T;\<|\+:T|
T=^I|I
I=integer|word
H=V|
B=begin C end;|begin C end
C=K\<|
# keyword statements FIRST so IF/FOR/WRITE are not tried as \i
K=if E then K else K|if E then K
|for \i:=E to E do K
|write(JW);|writeln(JW);[N]
|new(\i);|dispose(\i);|freemem(\i);|getmem(\i,E);|setlength(\i,E);
|B|;
|\i:=0;[Z\1]
|\i:=S+S;[L\2+\3S\1]
|\i:=S-S;[L\2-\3S\1]
|\i:=S;[L\2S\1]
|\i:=E;[S\1]
|\i\[E\]:=E;[S\1]
# J rule to print every expressions
# TODO: W snouldn't be needed if we have ?,
W=,J\<|
J=E[.]|"["]\S
# E = primary + optional left-assoc op chain (no precedence)
E=SO
# S = primary -> mem/const address (never ACC)
S=\d|\i(Z)|\i|sizeof(T)\#02|sizeof(\i)\#02|(E)|not S[?\2]
# O = op + primary; left in ACC, right is address from S (no \a needed)
O=+S[+\2]\<
|-S[-\2]\<
|*S[*\2]\<
|/S[/\2]\<
|&S[&\2]\<
|\|S[|\2]\<
|^S[^\2]\<
|=S[=\2]\<
|<S[<\2]\<
|>S[>\2]\<
|shl S[{\2]\<
|shr S[}\2]\<
|
Z=E,\<|E|
.


-- Legend
.   end of rules
|   at line start = continue previous rule

Tokens:
  \i  ident in scope -> slot
  \+  declare ident -> slot
  \d  number -> const 0x80|idx
  \s  string
  \S  copy bytes including last \0 (use: "\S )
  \[ \] literal brackets

Control:
  \{ \} scope  \< tail  \C commit
  \#xx  result := hex xx
  \=n   result := capture n

Generate:
  [..]  production (-v: Rule<[...]> on stderr)
  \1..\9  insert capture (auto-spill if ACC)
  \aN     force capture N to mem address

Expr:
  S primary = address only
  O ops: ACC := ACC op mem[S]
  E=SO  after first S, assignment must L\1 before O, or use K specials
  K specials S+S generate L a; + b; S dst in one go (clearer than general E)
