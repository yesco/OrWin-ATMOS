# -- BNF grammar for tpi.c PASCAL implementation
# K = statement, S = simple primary (address), O = op chain, E = expression
P=program \+;DB.
D=V\<|F\<|
V=var M
M=\+:T;\<|
# \f = declare function name (+ vector); [;] = return opcode after body
F=function \f\{(A):T;HB[;]\}
A=\+:T,\<|\+:T;\<|\+:T|
T=^I|I
I=integer|word
H=V|
# N matches end; or end without re-parsing C
N=end;|end
B=begin C N
C=K\<|
# keyword statements FIRST so IF/FOR/WRITE are not tried as \i
K=if E then K else K|if E then K
|for \i:=E to E do K
|writeln();[N]|writeln(JW);[N]|write();|write(JW);
|new(\i);|dispose(\i);|freemem(\i);|getmem(\i,E);|setlength(\i,E);
|B|;
|\i:=0;[Z\1]
|\i:=S+S;[L\2+\3S\1]
|\i:=S-S;[L\2-\3S\1]
|\i:=S;[L\2S\1]
|\i:=E;[S\1]
|\i\[E\]:=E;[S\1]
# JW: one or more J, comma-separated (W = optional ,J tail)
W=,J\<|
J=E[.]|"\S
# E = primary then ops. Call primary uses [\v] (ACC); others [L\1] load
E=\i(Z)[\v]O|S[L\1]O
# S = non-call primary -> address
S=\d|\i|sizeof(T)\#02|sizeof(\i)\#02|(E)|not S[?\1]
# O = op + RHS; RHS may be call (ACC) or address — use \a1 to force addr if ACC
O=+R[+\a1]\<
|-R[-\a1]\<
|*R[*\a1]\<
|/R[/\a1]\<
|&R[&\a1]\<
|\|R[|\a1]\<
|^R[^\a1]\<
|=R[=\a1]\<
|<R[<\a1]\<
|>R[>\a1]\<
|shl R[{\a1]\<
|shr R[}\a1]\<
|
# R = RHS of binary op: call or simple primary
R=\i(Z)[\v]|S
Z=E,\<|E|
.


-- Legend
.   end of rules
|   at line start = continue previous rule

Tokens:
  \i  ident in scope -> slot
  \+  declare ident -> slot
  \f  declare function ident -> slot + vector index

  \d  number -> const address (CONST_TOP down, via lit_addr)
  \s  string (match only)
  \S  emit string bytes + \0 (opening " already matched)

Control:
  \{ \} scope  \< tail  \C commit
  \#xx  result := hex xx
  \=n   result := capture n

Generate:
  [..]     production  (-v prints GEN only when alt commits)
  \1 - \9  capture byte
  \aN      force address (spill ACC to temp if needed)
  \v       emit 0xC0|vec for last matched function \i (in production)

  [;]      function return opcode (after body)


Expr:
  S = address
  E = call[\v]O | S[L\1]O leaves ACC
  R = call or S (RHS of binary ops)
  J = E[.] print ACC, or "\S string
  write(JW) / writeln(JW):
  J then optional W=,J tail
