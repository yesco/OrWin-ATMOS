# -- BNF grammar for tpi.c PASCAL implementation
P=program \i;DB.
D=VD|FD|
V=var M
M=\i:T;M|
F=function \i(A):T;HB
A=\i:T,A|\i:T;A|\i:T|
T=^I|I
I=integer|word
H=VB|
B=begin C end;|begin C end
C=SC|S|
S=\i:=E;|\i[E]:=E;|new(\i);|dispose(\i);|freemem(\i);|getmem(\i,E);|setlength(\i,E);|write(W);|writeln(W);|for \i:=E to E do S|if E then S else S|if E then S|B|;
W=J,W|J|
J=E|\s
E=RYE|R
Y=+|-|*|/|&|\|^|<|=|>|[|]|shl|shr
R=\n|\i(Z)|\i|sizeof(T)|sizeof(\i)|not R|(E)
Z=E,Z|E|
.


-- Legend
.   first on a line ends rules, parsing stops

Tokens:
  \c  quotes c 
  \i ident
  \n number
  \s string

Letters:
  Program
  Decls
  V/M var list
  Function
  Args
  Type
  Integer-ish
  H optional
  locals
  B block
  Compound stmts
  Stmt
  W/J write args
  Expr
  Y infix op
  R primary
  Z call args
