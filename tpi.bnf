# -- BNF grammar for tpi.c PASCAL implementation
# \< = tail-recurse current rule (replaces right-recursion)
# \C = commit matched prefix (drop line buffer head)
P=program \i;DB.
D=V\<|F\<|
V=var M
M=\i:T;\<|
F=function \i(A):T;HB
A=\i:T,\<|\i:T;\<|\i:T|
T=^I|I
I=integer|word
H=VB|
B=begin C end;|begin C end
C=S\<|
S=\i:=E;|\i[E]:=E;|new(\i);|dispose(\i);|freemem(\i);|getmem(\i,E);|setlength(\i,E);|write(W);|writeln(W);|for \i:=E to E do S|if E then S else S|if E then S|B|;
W=J,\<|J|
J=E|\s
E=RY\<|R
Y=+|-|*|/|&|\||^|<|=|>|[|]|shl|shr
R=\n|\i(Z)|\i|sizeof(T)|sizeof(\i)|not R|(E)
Z=E,\<|E|
.


-- Legend
.   first on a line ends rules, parsing stops

Tokens:
  \c  quotes c
  \i ident
  \n number
  \s string
  \< tail-recurse this rule
  \C commit (drop buffer prefix)
