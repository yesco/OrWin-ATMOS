# -- BNF grammar for tpi.c PASCAL implementation
# K = statement, S = simple primary (address), O = op chain, E = expression
P=program \+;DB.
D=V\<|F\<|
V=var M
M=\+:T;\<|
F=function \+\{(A):T;HB\}
A=\+:T,\<|\+:T;\<|\+:T|
T=^I|I
I=integer|word
H=V|
# N matches end; or end without re-parsing C
N=end;|end
B=begin C N
C=K\<|
# keyword statements FIRST so IF/FOR/WRITE are not tried as \i
K=if E then K else K|if E then K
|for \i:=E to E do K
|writeln();[N]|writeln(JW);[N]|write();|write(JW);
|new(\i);|dispose(\i);|freemem(\i);|getmem(\i,E);|setlength(\i,E);
|B|;
|\i:=0;[Z\1]
|\i:=S+S;[L\2+\3S\1]
|\i:=S-S;[L\2-\3S\1]
|\i:=S;[L\2S\1]
|\i:=E;[S\1]
|\i\[E\]:=E;[S\1]
# JW: one or more J, comma-separated (W = optional ,J tail)
W=,J\<|
J=E[.]|"["]\S
# E = load primary into ACC, then optional ops
E=S[L\1]O
S=\d|\i(Z)|\i|sizeof(T)\#02|sizeof(\i)\#02|(E)|not S[?\1]
O=+S[+\1]\<
|-S[-\1]\<
|*S[*\1]\<
|/S[/\1]\<
|&S[&\1]\<
|\|S[|\1]\<
|^S[^\1]\<
|=S[=\1]\<
|<S[<\1]\<
|>S[>\1]\<
|shl S[{\1]\<
|shr S[}\1]\<
|
Z=E,\<|E|
.


-- Legend
.   end of rules
|   at line start = continue previous rule

Tokens:
  \i  ident in scope -> slot
  \+  declare ident -> slot
  \d  number -> const 0x80|idx
  \s  string (match only)
  \S  emit string bytes + \0 (opening " already matched)

Control:
  \{ \} scope  \< tail  \C commit
  \#xx  result := hex xx
  \=n   result := capture n

Generate:
  [..]  production  (-v prints GEN only when alt commits)
  \1..\9  capture byte
  \aN     force address

Expr:
  S = address, E = S[L\1]O leaves ACC
  J = E[.] print ACC, or "\S string
  write(JW) / writeln(JW): J then optional W=,J tail
