program ShowcaseSuite;

var
  alpha : integer;
  beta  : integer;

begin
  { Test Case 1: Direct literal string compilation }
  writeln("Hello World from CP/M 6502!");

  { Test Case 2: 16-Bit variable immediate assignment }
  alpha := 15;

  { Test Case 3: Complex single-pass expression addition }
  beta := alpha + 32;

  { Test Case 4: Printing numeric value values out of memory }
  writeln(beta);
end.
