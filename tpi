rm -f tpi.asm tpi.s tpi.sim

cc65 -Oirs -T tpi.c -t sim6502
ca65 -l tpi.asm tpi.s

name=$1

rm $name.ivm

echo
echo "--------------- $name.p"
echo

cl65 -Oirs -t sim6502 -m tpi.map -o tpi.sim tpi.c || exit 1
echo

sim65 -c tpi.sim -O $name.p
#sim65 -c tpi.sim $name.p

echo
echo
ls -l tpi.sim
wc tpi.c

echo
echo
echo "=== Run from BLOB ==="
echo
sim65 -c tpi.sim $name.ivm | tee $name.log
echo
echo

echo
echo "=== tpi.c: `./wcode tpi.c` LOC ===" 
echo
ls -ugGlf $name.p $name.pas $name.c $name.prg $name.sim $name.ivm

echo
if [ -f "$name.out" ]; then
  echo "====================== DIFF ======================="
  diff -w -I "cycles" -I "RUN" -I "loaded" -U9999 tp-test.out tp-test.log \
  && printf "\n\t\t  -- TESTS OK --\n\n"
  diff -U0 tp-test.out tp-test.log

fi

