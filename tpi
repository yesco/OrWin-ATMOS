rm -f tpi.asm tpi.s tpi.sim ivm.sim ivm-noivm.sim 2>/dev/null

cc65 -Oirs -T tpi.c -t sim6502
ca65 -l tpi.asm tpi.s

name=$1

rm $name.ivm

echo
echo "--------------- $name.p"
echo

# exit code is run code? lol
cl65 -C sim6502.cfg -vm -Oirs -t sim6502 -m tpi.map -o tpi.sim tpi.c || exit 1

echo

sim65 -c tpi.sim -O $name.p || exit 1
#sim65 -c tpi.sim $name.p

echo
echo
ls -l tpi.sim
wc tpi.c

echo
echo
echo "===================== Run from BLOB ===================="
echo
sim65 -c tpi.sim $name.ivm
echo
echo

echo
echo
echo "==================== IVM Run from BLOB ================="
./ivm $name.ivm | tee $name.log
echo
echo

echo
echo
echo "======= ASM ===== IVM-ASM Run from BLOB ================"
./ivm-asm $name.ivm | tee $name.asm.log
echo
echo



if [ -f "$name.c" ]; then
  echo
  echo
  echo "========== C ===== $name.c Run from C ================"
  cl65 -t sim6502 -Oirs -vm -m test.map -o test.sim test.c -vm \
  && (sim65 -c test.sim | tee $name.c.log)
  echo
  echo
fi

echo
echo "=== tpi.c: `./wcode tpi.c` LOC ===" 
echo "=== ivm.c: `./wcode ivm.c` LOC ===" 
echo
ls -ugGlf $name.p $name.pas $name.c $name.ivm $name.sim $name.prg  2>/dev/null
ls -ugGlf tpi.c tpi.sim tpi.tap tpi.prg ivm.sim ivm-asm.sim ivm-asm-noivm.sim ivm-noivm.sim ivm.tap ivm.prg 2>/dev/null

echo
if [ -f "$name.out" ]; then
  echo "====================== DIFF ======================="
  (diff -a -w -I "cycles" -I "RUN" -I "loaded" -U9999 $name.out $name.log \
  && printf "\n\t\t  -- TESTS OK --\n\n") || diff -a -U0 $name.out $name.log


  echo "========== ASM ======= DIFF ======= ADM ==========="
  (diff -a -w -I "cycles" -I "RUN" -I "loaded" -U9999 $name.out $name.asm.log \
  && printf "\n\t\t  -- TESTS OK --\n\n") || diff -a -U0 $name.out $name.asm.log

fi

if [ -f "$name.c.log" ]; then
  echo "========== C ======= DIFF ======= C ==========="
  (diff -a -w -I "cycles" -I "RUN" -I "loaded" -U9999 $name.out $name.c.log \
  && printf "\n\t\t  -- TESTS OK --\n\n") || diff -a -U0 $name.out $name.c.log

fi

