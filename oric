#!/usr/bin/env python3
# oric - run a program on an emulated Oric Atmos (Phosphoric, headless):
#
#   ./oric test-swap            PROG, PROG.c, PROG.ivm all ok
#   ./oric test-swap -z         extra args go to the compiler (ivm-jit.x)
#   ./oric --live test-swap     at 1 MHz (real time), the screen redrawn
#                               ~10 times a second while it runs
#   ./oric --live-fast ...      the same, as fast as it goes
#   ./oric -b                   --basic: no program, just BASIC, live
#                               (--live alone: the same). Ctrl-] quits
#   ./oric --rom my.rom         your own 16K ROM instead, live (with a
#                               program too: it runs on that ROM)
#   ./oric game.tap             any .tap as it is: no build, just run it
#
# --live on a terminal: what you type goes to the Oric (keys, Return,
# Esc, Del/Backspace, arrows; Ctrl-x: CTRL-x and Alt-x: FUNCT-x if the
# emulator has keys-mod; Ctrl-C too: BASIC's break). Ctrl-] quits. It
# doesn't stop when the program ends (back in BASIC's Ready), no cycle
# limit: its cycles and output are the ones at its exit.
# keys-mod: Phosphoric's `keys` with \C<c> \F<c>. If ../Phosphoric has its
# source but not that, --live offers to patch it (patch_phosphoric: asks
# first; ORIC_NOPATCH=1: never) and rebuild it (make).
#
# A .tap not from the host compiler (its tape name isn't IVM) has no
# _ivmlib_exit: it runs until ORIC_CYCLES (default 100000000 for those)
# or Ctrl-C, then its screen is shown. Ctrl-C works in all modes.
# The host compiler writes PROG.tap (-tatmos, ivm-lib-atmos.bin), the
# emulator loads it (-f) with BASIC 1.1 and is driven by its --control
# protocol (stdin/stdout): breakpoints at the image's start and at
# ivm-lib's _ivmlib_exit count the program's cycles (on a real Atmos: the
# 50 Hz ROM interrupt and the ROM's char printing included); --live
# pauses it to read the screen. At the exit its text screen ($BB80,
# 40x28, raw bytes) is rendered as fillins.c does: serial ink / paper
# (reset each row), bit 7 inverse, ` as (c), ~ 127 as shades (colors only
# on a terminal), PROG.oric.scr. The lines after BASIC's "Ready" are the
# program's output, compared to PROG.out (its last lines: the screen
# only holds 26). Logs: PROG.oric-build.log, PROG.oric.log (the session).
#
#   PHOSPHORIC   the emulator (default ../Phosphoric/oric1-emu)
#   ORIC_ROM     the BASIC 1.1 ROM (default: Phosphoric's or the OSDK's;
#                --rom FILE wins)
#   ORIC_CYCLES  give up after (default 2000000000; other .tap: 100000000)
#   ORIC_WIDE=0  on a terminal of 80+ columns each Oric char is drawn
#                2 wide (fullwidth forms): 0 = 40 columns as is
#   ORIC_BOLD=0  bold on a terminal (the default: thicker strokes, more
#                contrast): 0 = normal

import os, re, select, struct, subprocess, sys, termios, time

here = os.path.dirname(os.path.abspath(sys.argv[0]))
up = os.path.dirname(here)


def die(m):
    sys.exit("%%Error: oric: %s" % m)


def first(*fs):
    for f in fs:
        if f and os.path.exists(f):
            return f
    return None


def lib_sym(name):
    """an address from ivm-lib-atmos.bin (mklib's symbol table)"""
    b = open("ivm-lib-atmos.bin", "rb").read()
    i = b.index(b"\0", 5) + 1
    _org, _len, n = struct.unpack_from("<HHH", b, i)
    i += 6
    for _ in range(n):
        a, = struct.unpack_from("<H", b, i)
        j = b.index(b"\0", i + 2)
        if b[i + 2:j].decode() == name:
            return a
        i = j + 1
    die("ivm-lib-atmos.bin has no %s (./mklib)" % name)


def sh(cmd, log):
    with open(log, "w") as f:
        return subprocess.run(cmd, shell=True, stdout=f, stderr=subprocess.STDOUT,
                              stdin=subprocess.DEVNULL).returncode   # (./pc runs it)


def norm(lines):
    """no whitespace (the screen's isn't the program's: tabs, the wrap)"""
    return ["".join(l.split()) for l in lines if l.strip()]


def unwrap(rows):
    """screen rows -> lines: a row that reaches the last columns goes on
    in the next one (the dump trims trailing spaces: >= 39)"""
    out, cur = [], ""
    for r in rows:
        cur += r
        if len(r.rstrip()) < 39:
            out.append(cur)
            cur = ""
    return out + ([cur] if cur else [])


class Emu:
    """Phosphoric --control: commands on its stdin, replies (OK / ERR) and
    events (EVT) on its stdout. Raw reads, own line buffer (select() can't
    see lines a file object has buffered already)"""

    def __init__(self, cmd, log):
        self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE,
                                  stdout=subprocess.PIPE,
                                  stderr=subprocess.DEVNULL,
                                  start_new_session=True)   # no ^C for it
        self.buf, self.log = b"", log

    def send(self, c):
        self.log.write("> %s\n" % c)
        self.p.stdin.write((c + "\n").encode("latin-1"))   # keys: $80-$84
        self.p.stdin.flush()

    def line(self, timeout=None):
        """the next line, None: none within timeout (or it exited)"""
        end = None if timeout is None else time.time() + timeout
        while b"\n" not in self.buf:
            t = None if end is None else max(0, end - time.time())
            if not select.select([self.p.stdout], [], [], t)[0]:
                return None
            d = os.read(self.p.stdout.fileno(), 65536)
            if not d:
                return None
            self.buf += d
        l, self.buf = self.buf.split(b"\n", 1)
        l = l.decode(errors="replace")
        self.log.write("< %s\n" % (l if len(l) < 200 else l[:200] + " ..."))
        return l

    def cmd(self, c):
        """c, its reply (events before it: self.evts)"""
        self.send(c)
        while True:
            l = self.line()
            if l is None:
                die("emulator gone (on: %s)" % c)
            if l.startswith(("OK", "ERR")):
                return l
            self.evts.append(l)

    evts = []

    def event(self, timeout=None):
        """the next EVT (stopped / halt), None: timeout"""
        while not self.evts:
            l = self.line(timeout)
            if l is None:
                return None
            if l.startswith("EVT"):
                self.evts.append(l)
        return self.evts.pop(0)


def evt(l, key):
    m = re.search(r"\b%s=(\S+)" % key, l or "")
    return m.group(1) if m else ""


# the screen, as fillins.c draws it: ink 0-7 / paper 16-23 attributes
# (serial: from there to the row's end), bit 7 inverse
INK = "\x1b[%dm"


# wide: each Oric char 2 columns (fullwidth forms U+FF01.., closer to its
# 6x8 cell), bold: thicker strokes. On a terminal only (ORIC_WIDE=0,
# ORIC_BOLD=0: off); wide needs 80+ columns
def wide_ch(c):
    if 0x21 <= c <= 0x7d and c != 0x60:
        return chr(0xff01 + c - 0x21)
    return {0x60: "\u00a9 ", 126: "\u2592\u2592", 127: "\u2588\u2588"}.get(c, "  ")


def render(scr, color, wide=0, bold=0):
    """raw $BB80 bytes -> (rows to show, plain ASCII rows: the output)"""
    show, plain = [], []
    for y in range(28):
        fg, bg, s, a = 7, 0, "", ""
        if color:
            s = "\x1b[0m" + ("\x1b[1m" if bold else "") + INK % 37 + INK % 40
        for c in scr[40 * y:40 * y + 40]:
            inv, c = c & 0x80, c & 0x7f
            if c < 32:
                if c < 8:
                    fg = c
                elif 16 <= c < 24:
                    bg = c & 7
                ch, a = "  " if wide else " ", a + " "
            elif wide:
                ch = wide_ch(c)
                a += chr(c)
            else:
                ch = {0x60: "\u00a9", 126: "\u2592", 127: "\u2588"}.get(c, chr(c))
                a += chr(c)
            if color:
                f, b = (7 - fg, 7 - bg) if inv else (fg, bg)
                s += INK % (30 + f) + INK % (40 + b) + ch
            else:
                s += ch
        show.append(s + ("\x1b[0m" if color else ""))
        plain.append(a)
    return show, plain


# terminal bytes -> the emulator's `keys` text. Arrows and DEL: its codes
# $80-$84; space and \\ escaped (keys skips leading blanks). mod: the
# emulator knows \C<c> \F<c> (CTRL, FUNCT; Phosphoric's keys-mod)
ARROW = {b"A": "\x80", b"B": "\x81", b"D": "\x82", b"C": "\x83"}
QUIT = 0x1d                                     # Ctrl-]


def to_keys(b, mod):
    out, i = "", 0
    while i < len(b):
        c = b[i]
        i += 1
        if c == 0x1b:                           # ESC [ A.., ESC O A.., Alt-x
            if b[i:i + 1] in (b"[", b"O") and b[i + 1:i + 2] in ARROW:
                out += ARROW[b[i + 1:i + 2]]
                i += 2
            elif b[i:i + 3] == b"[3~":          # Delete
                out += "\x84"
                i += 3
            elif i < len(b) and 0x20 < b[i] < 0x7f:
                if mod:
                    out += "\\F" + chr(b[i])
                i += 1
            else:
                out += "\\e"
        elif c in (10, 13):
            out += "\\n"
        elif c in (8, 127):
            out += "\x84"                      # DEL (backspace)
        elif c == 9:
            out += "\\t"
        elif c < 32:
            if mod:
                out += "\\C" + chr(c + 96)    # Ctrl-a: 1 -> a
        elif c == 32:
            out += "\\ "
        elif c == 92:
            out += "\\\\"
        elif c < 127:
            out += chr(c)
    return out


# keys-mod for Phosphoric: `keys` takes \C<c> \F<c> (<c> + CTRL / FUNCT),
# queued as a marker byte ($85 / $86) before <c>; the feeder holds the
# modifier with it. Each edit: (file, old, new), old must be there once
PHOS_PATCH = [
    ("src/control.c",
     "        char c = *p;\n",
     "        char c = *p, pre = 0;   /* oric keys-mod: CTRL / FUNCT marker */\n"),
    ("src/control.c",
     "                case '\\\\': c = '\\\\'; break;\n",
     "                case '\\\\': c = '\\\\'; break;\n"
     "                case 'C': case 'F':   /* oric keys-mod: \\C<c> \\F<c>, <c> + CTRL / FUNCT */\n"
     "                    if (p[1] && (unsigned char)p[1] > 0x20 && (unsigned char)p[1] < 0x80) {\n"
     "                        pre = *p == 'C' ? (char)0x85 : (char)0x86;\n"
     "                        p++; c = *p; break;\n"
     "                    }\n"
     "                    c = *p; break;\n"),
    ("src/control.c",
     "        if (emu->kbd_inject_len + 1 > emu->kbd_inject_cap) {\n",
     "        if (emu->kbd_inject_len + 2 > emu->kbd_inject_cap) {   /* oric keys-mod: + pre */\n"),
    ("src/control.c",
     "        emu->kbd_inject_buf[emu->kbd_inject_len++] = c;\n",
     "        if (pre) emu->kbd_inject_buf[emu->kbd_inject_len++] = pre;   /* oric keys-mod */\n"
     "        emu->kbd_inject_buf[emu->kbd_inject_len++] = c;\n"),
    ("src/control.c",
     ",sym-group,stuck-bits\"",
     ",sym-group,stuck-bits,keys-mod\""),
    ("src/main.c",
     "            unsigned char ic = (unsigned char)emu->kbd_inject_buf[emu->kbd_inject_pos];\n",
     "            unsigned char ic = (unsigned char)emu->kbd_inject_buf[emu->kbd_inject_pos];\n"
     "            unsigned char mod = 0;   /* oric keys-mod: $85 CTRL / $86 FUNCT + the next */\n"
     "            if ((ic == 0x85 || ic == 0x86) && emu->kbd_inject_pos + 1 < emu->kbd_inject_len) {\n"
     "                mod = ic;\n"
     "                ic = (unsigned char)emu->kbd_inject_buf[++emu->kbd_inject_pos];\n"
     "            }\n"),
    ("src/main.c",
     "                oric_keyboard_press_char(&emu->keyboard, (char)ic);\n",
     "                oric_keyboard_press_char(&emu->keyboard, (char)ic);\n"
     "            if (mod == 0x85) oric_keyboard_press_ctrl(&emu->keyboard);    /* oric keys-mod */\n"
     "            if (mod == 0x86) oric_keyboard_press_funct(&emu->keyboard);\n"),
]


def patch_phosphoric(emu):
    """Phosphoric next to us, its source there, no keys-mod in it: ask, then
    patch it and make. Patched but the binary older: make. 1: rebuilt"""
    d = os.path.dirname(emu)
    srcs = sorted(set(f for f, _, _ in PHOS_PATCH))
    if os.environ.get("ORIC_NOPATCH") or \
       not all(os.path.exists(os.path.join(d, f)) for f in srcs):
        return 0
    text = {f: open(os.path.join(d, f)).read() for f in srcs}
    if all("oric keys-mod" in t for t in text.values()):
        if os.path.getmtime(emu) >= max(os.path.getmtime(os.path.join(d, f))
                                        for f in srcs):
            return 0
    else:
        for f, old, _ in PHOS_PATCH:            # all there, once: else nothing
            if text[f].count(old) != 1:
                print("oric: can't patch %s for CTRL/FUNCT keys (not the "
                      "Phosphoric it knows)" % os.path.join(d, f))
                return 0
        print("Phosphoric's `keys` can't send CTRL-x / FUNCT-x. Patch its "
              "source for that\n  (%s: %s, ~20 lines, marked \"oric keys-mod\")"
              " and rebuild it with make? [y/N] " % (d, " ".join(srcs)),
              end="", flush=True)
        if sys.stdin.readline().strip().lower() not in ("y", "yes"):
            print("(not patched; ORIC_NOPATCH=1 stops this question)")
            return 0
        for f, old, new in PHOS_PATCH:
            text[f] = text[f].replace(old, new)
        for f in srcs:
            open(os.path.join(d, f), "w").write(text[f])
    log = os.path.join(here, "phosphoric-make.log")
    print("$ make -C %s > %s" % (d, log), flush=True)
    if sh("make -C %s" % d, log):
        die("make failed (see %s)" % log)
    return 1


def tap_info(b):
    """an Oric .tap header: (type, start, name). Sync bytes $16.., $24,
    2 bytes, type ($80 machine code, 0 BASIC), autorun, end, start (big
    endian), a byte, the name, 0"""
    i = 0
    while i < len(b) and b[i] == 0x16:
        i += 1
    if i == 0 or i + 10 > len(b) or b[i] != 0x24:
        die("not an Oric .tap (no sync bytes / $24)")
    h = b[i + 1:]
    j = h.index(0, 9) if 0 in h[9:] else len(h)
    return h[2], h[6] << 8 | h[7], h[9:j].decode(errors="replace")


def main():
    flags = ("--live", "--live-fast", "-b", "--basic")
    opts, args, romf, av = [], [], None, sys.argv[1:]
    while av:                                   # --rom FILE, --rom=FILE
        a = av.pop(0)
        if a == "--rom" and av:
            romf = os.path.abspath(av.pop(0))
        elif a.startswith("--rom="):
            romf = os.path.abspath(a[6:])
        elif a in flags:
            opts.append(a)
        else:
            args.append(a)
    live, fast = bool(opts) or romf is not None, "--live-fast" in opts
    if romf and not os.path.exists(romf):
        die("no ROM %s" % romf)
    if not args and not live:
        die("usage: ./oric [--live|--live-fast] PROG [compiler args] | FILE.tap\n"
            "       ./oric -b|--basic|--rom FILE.rom   (BASIC / a ROM, live)")
    sys.argv[1:] = args
    # a .tap: as it is (its path from here, before the chdir)
    tapf = None
    if args and args[0].endswith(".tap") and os.path.exists(args[0]):
        tapf = os.path.abspath(args[0])
    os.chdir(here)
    name = sys.argv[1] if args else ""
    if tapf:
        name = tapf[:-4]
    elif re.match(r"^[^/]+\.[^./]+$", os.path.basename(name)):
        name = name.rsplit(".", 1)[0]
    extra = " ".join(sys.argv[2:])
    emu = first(os.environ.get("PHOSPHORIC"), up + "/Phosphoric/oric1-emu")
    rom = first(romf, os.environ.get("ORIC_ROM"),
                up + "/Phosphoric/roms/basic11b.rom",
                up + "/osdk/osdk/main/Osdk/_final_/Roms/basic11b.rom")
    if not emu:
        die("no Phosphoric (../Phosphoric/oric1-emu, or set PHOSPHORIC)")
    if not rom:
        die("no BASIC 1.1 ROM (set ORIC_ROM)")

    # no program: just the ROM, live (logs: ROM.oric.log)
    if not args:
        name = os.path.splitext(os.path.basename(rom))[0]
        limit = int(os.environ.get("ORIC_CYCLES", 100000000))
        return run_tap(name, None, b"", 0, 0, None, limit, emu, rom, live,
                       fast)

    # the program, the host compiler, the lib: only what is stale
    if not tapf:
        build_tap(name, extra)
    tapf = tapf or name + ".tap"
    tap = open(tapf, "rb").read()
    ttype, start, tname = tap_info(tap)
    ours = tname == "IVM" and ttype & 0x80
    exit_ = lib_sym("_ivmlib_exit") if ours else None
    limit = int(os.environ.get("ORIC_CYCLES",
                               2000000000 if ours else 100000000))
    return run_tap(name, tapf, tap, ttype, start, exit_, limit, emu, rom,
                   live, fast)


def build_tap(name, extra):
    build = ". ./deps; "
    if not os.path.exists(name + ".ivm") or \
       os.path.getmtime(name + ".c") > os.path.getmtime(name + ".ivm"):
        build += "bash ./pc %s -c >/dev/null || exit 1; " % name
    build += ("if stale ivm-jit.x $IVM_SRC jit; then clang -DMEMMAP -DVERBOSE"
              " -DJIT -g ivm.c -o ivm-jit.x || exit 1; fi; "
              "if stale ivm-lib-atmos.bin ivm-lib.asm mklib; then ./mklib"
              " || exit 1; fi; "
              "./ivm-jit.x -tatmos -o%s.tap %s.ivm %s" % (name, name, extra))
    print("$ ./ivm-jit.x -tatmos -o%s.tap %s.ivm %s > %s.oric-build.log"
          % (name, name, extra, name), file=sys.stderr)
    if os.path.exists(name + ".tap"):
        os.remove(name + ".tap")
    if sh(build, name + ".oric-build.log") or not os.path.exists(name + ".tap"):
        die("no %s.tap (see %s.oric-build.log)" % (name, name))


def run_tap(name, tapf, tap, ttype, start, exit_, limit, emu, rom, live, fast):
    """run it; ours (exit_): its cycles, its output vs the .out"""
    # break at the start (machine code) and the exit (ours), go; --live
    # (and without an exit: to see the limit): pause, read the screen,
    # draw it, go on
    scr = name + ".oric.scr"
    # live on a terminal: stays after the exit (BASIC), no limit, Ctrl-]
    stay = live and sys.stdout.isatty() and sys.stdin.isatty()
    if stay:
        patch_phosphoric(emu)
    cmd = [emu, "--control", "-n", "-m", "atmos", "-r", rom]
    if tapf:
        cmd += ["-f", "-t", tapf]
    if not stay:
        cmd += ["-c", str(limit * 2)]
    if live and not fast:
        cmd.append("--realtime")
    print("$ %s > %s.oric.log" % (" ".join(cmd), name), file=sys.stderr)
    color = sys.stdout.isatty()
    cols = os.get_terminal_size().columns if color else 0
    wide = color and cols >= 82 and os.environ.get("ORIC_WIDE") != "0"
    bold = color and os.environ.get("ORIC_BOLD") != "0"
    log = open(name + ".oric.log", "w")
    e = Emu(cmd, log)
    while not (e.event() or "EVT stopped").startswith("EVT stopped"):
        pass                                    # ready, then stopped at reset
    mod = "keys-mod" in e.cmd("hello client=oric proto=1")
    # --live on a terminal: keys to the Oric (no echo, no line editing, no
    # ^C signal: it is the Oric's; the output as it was)
    tin = sys.stdin.fileno() if live and color and sys.stdin.isatty() else None
    if tin is not None:
        told = termios.tcgetattr(tin)
        t = termios.tcgetattr(tin)
        t[0] &= ~(termios.IXON | termios.ICRNL)
        t[3] &= ~(termios.ECHO | termios.ICANON | termios.ISIG | termios.IEXTEN)
        termios.tcsetattr(tin, termios.TCSANOW, t)
    if ttype & 0x80:
        e.cmd("break %04X" % start)
    if exit_:
        e.cmd("break %04X" % exit_)
    e.cmd("continue")
    cyc, done, frame, t0, why = [], 0, 0, time.time(), ""
    at_exit = None                              # stay: its screen at the exit
    poll = 0.1 if live else 0.5
    # not live, stdin not a terminal: what it gives, typed once the program
    # runs, as it comes (printf 'hi\x1b' | ./oric test-getchar; /dev/null:
    # nothing). Never waited for: a pipe nobody writes to is just empty
    fin = None if tin is not None or sys.stdin.isatty() else sys.stdin.fileno()
    feed = b"" if fin is not None else None
    last, idle, fed = b"", 0, 0.0
    # where it waits for a key: the ROM ($0238.. its page 2 vectors), ours:
    # ivm-lib's getchar (to the lib's end)
    wait = [(0xC000, 0x10000), (0x0238, 0x0240)]
    if exit_:
        wait.append((lib_sym("_opgetchar"), lib_sym("_ivmlib_end")))

    def screen():
        r = e.cmd("read BB80 460")
        return bytes(int(x, 16) for x in r.split()[1:])

    def draw(rows, status):
        sys.stdout.write("\x1b[H" + "\n".join(rows) + "\n" + status + "\x1b[K\n")
        sys.stdout.flush()

    if live and color:
        sys.stdout.write("\x1b[2J\x1b[?25l")
    try:
        while True:
            l = e.event(poll)
            if l is None and poll:              # a frame: pause, look, go on
                e.cmd("pause")
                l = e.event()
                # a pause in the same frame as a breakpoint: reason=user,
                # at its pc. Then it is that breakpoint
                if ttype & 0x80 and not cyc and evt(l, "pc") == "%04X" % start:
                    l = l.replace("reason=user", "reason=break")
                if exit_ and evt(l, "pc") == "%04X" % exit_:
                    l = l.replace("reason=user", "reason=break")
                if evt(l, "reason") == "user":
                    frame += 1
                    now = int(evt(l, "cycles"))
                    if live:
                        draw(render(screen(), color, wide, bold)[0] if color else [""],
                             "%s: %s %s cycles, %.1f s" % (
                                 os.path.basename(name),
                                 "in BASIC, exited after" if done else
                                 "running" if cyc or not tapf else "booting",
                                 "{:,}".format((cyc[-1] if done else now) -
                                               (cyc[0] if cyc else 0)),
                                 time.time() - t0) +
                             (" (Ctrl-] quits)" if stay else ""))
                    if now >= limit and not stay:   # (stopped: the screen is there)
                        why = "the limit, %s cycles" % "{:,}".format(limit)
                        break
                    if feed is not None and cyc:   # it runs: the input
                        new = b""
                        while fin is not None and \
                                select.select([fin], [], [], 0)[0]:
                            d = os.read(fin, 1024)
                            if not d:
                                fin = None          # its end
                                break
                            new += d
                        k = to_keys(new, mod)
                        if k:
                            e.cmd("keys " + k)
                            fed = max(fed, time.time()) + 0.1 * len(new)  # 5 frames a key
                        fed = fed or time.time()
                        # waiting for a key that won't come: in getchar / the
                        # ROM, the screen as it was, all input typed (10 s)
                        scr_now = bytes(c & 0x7f for c in screen())   # (the
                        # cursor blinks: its bit 7)
                        pc = int(evt(l, "pc") or "0", 16)
                        idle = idle + 1 if scr_now == last and \
                            any(a <= pc < b for a, b in wait) and \
                            time.time() > fed else 0
                        last = scr_now
                        if idle >= 20:
                            why = "waiting for a key (no more input)"
                            break
                    typed = b""                 # what was typed since
                    while tin is not None and select.select([tin], [], [], 0)[0]:
                        typed += os.read(tin, 1024)
                    if QUIT in typed:
                        why = "Ctrl-]"
                        break
                    k = to_keys(typed, mod)
                    if k:
                        e.cmd("keys " + k)
                    e.cmd("continue")
                    continue
            if l is None or l.startswith("EVT halt"):
                why = why or "the emulator stopped (%s)" % evt(l, "reason")
                break
            if evt(l, "reason") == "break" and not done:
                cyc.append(int(evt(l, "cycles")))
                if exit_ and evt(l, "pc") == "%04X" % exit_:
                    done = 1
                    if not stay:
                        break
                    at_exit = screen()          # rts: on in BASIC
            e.cmd("continue")
    except KeyboardInterrupt:                   # stop it where it is
        why = "Ctrl-C"
        e.cmd("pause")
        e.event(1)
    finally:
        if tin is not None:
            termios.tcsetattr(tin, termios.TCSANOW, told)
    raw = screen() if e.p.poll() is None else b""
    if at_exit is not None:                     # the program's, not BASIC's
        raw = at_exit
    rows, plain = render(raw, color, wide, bold)
    try:
        e.send("quit")
        e.p.wait(5)
    except Exception:
        e.p.kill()
    log.close()
    if live and color:
        sys.stdout.write("\x1b[?25h\x1b[2J\x1b[H")
    open(scr, "w").write("".join(r.rstrip() + "\n" for r in render(raw, 0)[0]))

    # the screen
    lines = [r.rstrip() for r in plain]
    while lines and not lines[-1].strip():
        lines.pop()
    print("+" + "-" * (80 if wide else 40) + "+")
    for r in rows[:len(lines)]:
        print("|%s|" % r)
    print("+" + "-" * (80 if wide else 40) + "+")
    done = done and len(cyc) >= 2

    if not exit_:                               # not ours: no exit, no .out
        print("= %s: stopped by %s" % (os.path.basename(tapf or name), why))
        return 0
    if not done and why in ("Ctrl-]", "Ctrl-C") or why.startswith("waiting"):
        print("= %s: stopped by %s" % (os.path.basename(name), why))
        return 1
    if not done:
        print("%%Error: oric: %s never reached _ivmlib_exit $%04X (see %s.oric.log)"
              % (name, exit_, name))
        return 1
    print("= %s cycles (%5d bytes) - oric  - %s"
          % ("{:,}".format(cyc[-1] - cyc[0]), len(tap), os.path.basename(name)))

    # its output: after BASIC's Ready (row 0: the status line), vs the end
    # of the .out. Scrolled away: all rows but the top one (maybe a part)
    rows = lines[1:]
    for i, l in enumerate(lines):
        if l.strip() == "Ready":
            rows = lines[i + 1:]
            break
    else:
        rows = rows[1:]
    got = norm(unwrap(rows))
    if os.path.exists(name + ".out"):
        want = norm(open(name + ".out").read().split("\n"))
        tail = want[-len(got):] if got else []
        if got == tail and (got or not want):    # (nothing: only if none)
            print("matches %s.out%s" % (name, " (its last %d lines)" % len(got)
                                       if len(got) < len(want) else ""))
        else:
            print("%%Error: oric DIFFERS from %s.out" % name)
            for w, g in zip(tail + [""] * len(got), got):
                if w != g:
                    print("  - %s\n  + %s" % (w, g))
            return 1
    return 0


sys.exit(main())
