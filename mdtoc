#!/usr/bin/env python3
# mdtoc - a linked index of a .md file's ## and ### headings, and its
# tables aligned (columns padded, ---: columns right aligned)
#
#   ./mdtoc MeteoriC-man.md      updates the file in place
#
# The index goes between these two lines (put them where it should be):
#
#   <!-- toc -->
#   <!-- /toc -->
#
# Links are GitHub's heading anchors. Headings inside ``` blocks are not
# headings (#define, #ifdef ...).

import re, sys

START, END = "<!-- toc -->", "<!-- /toc -->"


def anchor(title, seen):
    """GitHub's anchor: lower case, punctuation gone, spaces to -"""
    a = re.sub(r"[^\w\- ]", "", title.lower()).replace(" ", "-")
    n = seen.get(a, 0)
    seen[a] = n + 1
    return a if n == 0 else "%s-%d" % (a, n)


def headings(lines):
    """(level, title, anchor) of the ## and ### headings, not in code"""
    out, seen, code = [], {}, False
    for l in lines:
        if l.startswith("```"):
            code = not code
            continue
        m = re.match(r"^(#{1,3}) (.*\S)\s*$", l)
        if code or not m:
            continue
        title = m.group(2)
        a = anchor(title, seen)
        if len(m.group(1)) > 1:
            out.append((len(m.group(1)), title, a))
    return out


def align(block):
    """a table's lines, padded: each column as wide as its widest cell"""
    # a cell's own | is \| (GitHub): split only on the others
    rows = [[c.strip() for c in re.split(r"(?<!\\)\|", l.strip()[1:-1])]
            for l in block]
    n = max(len(r) for r in rows)
    rows = [r + [""] * (n - len(r)) for r in rows]
    sep = [set(c) <= set("-: ") and c != "" for c in rows[1]] if len(rows) > 1 else []
    if len(rows) < 2 or not all(sep):
        return block                            # not a table: as it is
    right = [c.endswith(":") for c in rows[1]]
    w = [max([len(r[i]) for k, r in enumerate(rows) if k != 1] + [3])
         for i in range(n)]
    out = []
    for k, r in enumerate(rows):
        if k == 1:
            cells = [("-" * (w[i] - 1) + ":") if right[i] else "-" * w[i]
                     for i in range(n)]
        else:
            cells = [r[i].rjust(w[i]) if right[i] else r[i].ljust(w[i])
                     for i in range(n)]
        out.append("| " + " | ".join(cells) + " |")
    return out


def tables(lines):
    """every table outside ``` blocks aligned"""
    out, code, k = [], False, 0
    while k < len(lines):
        l = lines[k]
        if l.startswith("```"):
            code = not code
        if not code and l.startswith("|"):
            b = []
            while k < len(lines) and lines[k].startswith("|"):
                b.append(lines[k])
                k += 1
            out += align(b)
            continue
        out.append(l)
        k += 1
    return out


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: ./mdtoc FILE.md")
    path = sys.argv[1]
    lines = open(path).read().split("\n")
    if START not in lines or END not in lines:
        sys.exit("%%Error: mdtoc: no %s / %s lines in %s" % (START, END, path))

    # the index
    toc = []
    for level, title, a in headings(lines):
        indent = "  " * (level - 2)
        toc.append("%s- [%s](#%s)" % (indent, title, a))

    # between the markers, then the tables
    i, j = lines.index(START), lines.index(END)
    lines[i + 1:j] = [""] + toc + [""]
    lines = tables(lines)
    open(path, "w").write("\n".join(lines))
    print("%s: %d headings" % (path, len(toc)))


main()
